<Window x:Class="StreamMesh.Windows.SourceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaynak Düzenleyici" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a" Foreground="#f8fafc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SourceTitleText" Text="Kaynak: ..." FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>
        
        <Border Grid.Row="1" Background="#1e293b" Padding="15" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Seçililer için Dil Seç:" VerticalAlignment="Center" Foreground="#94a3b8" Margin="0,0,10,0"/>
                <ComboBox x:Name="LanguageCombo" Width="150" Height="35" IsEditable="True"/>
                <Button x:Name="ApplyLanguageBtn" Content="Dili Uygula" Width="100" Height="35" Margin="10,0,20,0" 
                        Click="ApplyLanguageBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#0ea5e9"/>
                
                <Rectangle Width="1" Fill="#334155" Margin="0,0,20,0"/>
                
                <Button x:Name="SmartGuessBtn" Content="✨ Akıllı Dil Tahmini" Width="150" Height="35" 
                        Click="SmartGuessBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#8b5cf6"/>
                <TextBlock Text="*(Kanal ismine göre tahmin eder)" FontSize="10" VerticalAlignment="Bottom" Foreground="#64748b" Margin="5,0,0,5"/>

                <Rectangle Width="1" Fill="#334155" Margin="20,0,20,0"/>
                
                <Button x:Name="SelectAllBtn" Content="Hepsini Seç" Width="100" Height="35" Margin="0,0,10,0"
                        Click="SelectAllBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#475569"/>
                <Button x:Name="DeselectAllBtn" Content="Seçimi Kaldır" Width="100" Height="35"
                        Click="DeselectAllBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#475569"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="ChannelsDataGrid" AutoGenerateColumns="False" 
                  Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155"
                  RowBackground="#1e293b" AlternatingRowBackground="#1e293b"
                  HeadersVisibility="Column" SelectionMode="Extended" CanUserAddRows="False">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#38bdf8"/>
                            <Setter Property="Foreground" Value="#0f172a"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Kanal Adı" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Mevcut Dil" Binding="{Binding Language}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Grup" Binding="{Binding GroupTitle}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="SelectionCountText" Text="0 kanal seçili" VerticalAlignment="Center" Foreground="#94a3b8" Margin="0,0,20,0"/>
            <Button x:Name="CloseBtn" Content="Kapat" Width="100" Height="35" Click="CloseBtn_Click" 
                    Style="{StaticResource PrimaryButtonStyle}" Background="#475569"/>
        </StackPanel>
    </Grid>
</Window>
