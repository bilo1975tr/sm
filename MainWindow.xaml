<Window x:Class="StreamMesh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:StreamMesh.Services"
        Title="StreamMesh" Height="700" Width="1000" Background="#0f172a" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Helvetica Neue, sans-serif" FontSize="14" Foreground="#f8fafc"
        Icon="pack://application:,,,/app_icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sol Menü (Sidebar) -->
            <ColumnDefinition x:Name="SidebarColumn" Width="80" />
            <!-- Ana İçerik -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!-- SIDEBAR -->
        <Border x:Name="MainSidebar" Grid.Column="0" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <Image Source="pack://application:,,,/logos/StreamMesh_logo.png" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Background="#334155" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" Margin="0,2,0,20">
                    <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="📺" ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[NavLibrary]}" GroupName="NavMenu" x:Name="NavHome" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="▶️" ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[NavPlayer]}" GroupName="NavMenu" x:Name="NavPlayer" IsChecked="True" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="🔍" ToolTip="Ace Stream Arama" GroupName="NavMenu" x:Name="NavSearch" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="📊" ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[NavStats]}" GroupName="NavMenu" x:Name="NavStats" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavButtonStyle}" Content="⚙️" ToolTip="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[NavSettings]}" GroupName="NavMenu" x:Name="NavSettings" Click="Nav_Click"/>
                
                <!-- Spacer -->
                <Border Height="30"/>
                <!-- AI Chat Button -->
                <Button x:Name="AiButton" Content="🤖" ToolTip="AI Asistan" Width="40" Height="40" Background="Transparent" Foreground="#38bdf8" FontSize="20" BorderThickness="0" Cursor="Hand" Click="AIChatButton_Click" HorizontalAlignment="Center"/>
                <!-- VIP / Destek Button -->
                <Button Content="💎" ToolTip="VIP &amp; Destek" Width="40" Height="40" Background="Transparent" Foreground="#fbbf24" FontSize="20" BorderThickness="0" Cursor="Hand" Click="VIPButton_Click" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20" />
    </Grid>
</Window>
