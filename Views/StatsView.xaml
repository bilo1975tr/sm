<UserControl x:Class="StreamMesh.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:StreamMesh.Services"
             Background="Transparent" Foreground="#f8fafc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Stats_Title]}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <!-- DB Stats -->
            <Border Background="#1e293b" CornerRadius="12" Padding="20" Margin="0,0,20,20" BorderBrush="#334155" BorderThickness="1" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Stats_DB]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TotalChannelsText" Text="Toplam Kanal: 0" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="M3uChannelsText" Text="M3U: 0" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="YoutubeChannelsText" Text="YouTube: 0" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="AceChannelsText" Text="AceStream: 0" FontSize="16" Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- Cloud Stats -->
            <Border Background="#1e293b" CornerRadius="12" Padding="20" Margin="0,0,20,20" BorderBrush="#334155" BorderThickness="1" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Stats_CloudSync]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,15"/>
                    <TextBlock x:Name="GitHubChanCountText" Text="GitHub'dan Gelen: 0" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="GitHubLastSyncText" Text="Son Okuma: Bekleniyor" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="FirebasePushedText" Text="Firebase Havuza Gönderilen: 0" FontSize="16" Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- P2P Stats -->
            <Border Background="#1e293b" CornerRadius="12" Padding="20" Margin="0,0,20,20" BorderBrush="#334155" BorderThickness="1" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="P2P Mesh İstatistikleri" FontWeight="Bold" FontSize="18" Foreground="#10b981" Margin="0,0,0,15"/>
                    <TextBlock x:Name="P2pClientIdText" Text="İstemci ID: -" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="P2pOnlineCountText" Text="Mesh'teki Aktif Cihazlar: 1" FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="P2pNatTypeText" Text="Sizin NAT Tipi: Saptanıyor..." FontSize="16" Margin="0,5"/>
                    <TextBlock x:Name="P2pCompressionRatioText" Text="Sıkıştırma Oranı: Aktif (GZip)" FontSize="16" Margin="0,5"/>
                </StackPanel>
            </Border>
            
            <Button Content="Verileri Yenile" Width="150" Height="40" Click="RefreshStatsBtn_Click" VerticalAlignment="Top" Style="{StaticResource PrimaryButtonStyle}" />
        </WrapPanel>

        <!-- Sistem ve Ağ Konsolu -->
        <Border Grid.Row="2" Background="#0f172a" CornerRadius="12" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Stats_SysConsole]}" FontWeight="Bold" FontSize="16" Foreground="#10b981" Margin="0,0,0,10"/>
                <TextBox Grid.Row="1" x:Name="ConsoleOutput" Background="Transparent" Foreground="#10b981" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
