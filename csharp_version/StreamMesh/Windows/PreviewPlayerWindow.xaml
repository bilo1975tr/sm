<Window x:Class="StreamMesh.Windows.PreviewPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Kanal Önizleme" Height="440" Width="660"
        Background="#0f172a" Foreground="#f8fafc"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="/logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Kontrol Barı -->
        <Border Grid.Row="0" Background="#1e293b" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#334155">
            <Grid>
                <TextBlock x:Name="ChannelNameTxt" Text="Kanal Önizleme" FontSize="14" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Ekran Boyutu: " Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                    <Button Content="Ufak" Width="60" Height="26" Click="Ufak_Click" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"/>
                    <Button Content="Orta" Width="60" Height="26" Click="Orta_Click" Background="#38bdf8" Foreground="White" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" FontWeight="Bold"/>
                    <Button Content="Büyük" Width="60" Height="26" Click="Buyuk_Click" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video Alanı -->
        <Grid Grid.Row="1" Background="Black">
            <vlc:VideoView x:Name="VlcVideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <TextBlock x:Name="StatusTxt" Text="Yayın yükleniyor..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="13"/>
        </Grid>

        <!-- Alt Durum Barı -->
        <Border Grid.Row="2" Background="#1e293b" Padding="8" BorderThickness="0,1,0,0" BorderBrush="#334155">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoTxt" Grid.Column="0" Text="Yükleniyor, lütfen bekleyin..." FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ResolutionTxt" Grid.Column="1" Text="" FontSize="11" Foreground="#10b981" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
