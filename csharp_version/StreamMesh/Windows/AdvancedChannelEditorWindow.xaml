<Window x:Class="StreamMesh.Windows.AdvancedChannelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gelişmiş Kanal Yöneticisi" Height="700" Width="1000"
        Background="#0f172a" Foreground="#f8fafc"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="SearchTxt" Width="200" Height="30" VerticalContentAlignment="Center" TextChanged="SearchTxt_TextChanged" />
                <Button Content="Ara (Benzer Bul)" Width="100" Height="30" Margin="10,0,0,0" Background="#38bdf8" Foreground="White" BorderThickness="0" Click="SearchBtn_Click" />
                <Button Content="Akıllı Grupla (%90)" Width="120" Height="30" Margin="10,0,0,0" Background="#8b5cf6" Foreground="White" BorderThickness="0" Click="SmartGroupBtn_Click" ToolTip="Kanalları kalite eklerini yok sayarak isme göre gruplar" />
            </StackPanel>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" x:Name="GroupColumn" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <ListBox x:Name="GroupList" Grid.Column="0" Margin="0,0,10,0" Background="#1e293b" Foreground="#f8fafc" BorderThickness="1" BorderBrush="#334155" Visibility="Collapsed" SelectionChanged="GroupList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" Margin="5" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListView x:Name="ChannelsList" Grid.Column="1" Background="#1e293b" Foreground="White" BorderThickness="1" BorderBrush="#334155">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Logo" Width="60">
                             <GridViewColumn.CellTemplate>
                                 <DataTemplate>
                                     <Image Source="{Binding DisplayImageUrl}" Width="40" Height="40" Stretch="Uniform">
                                         <Image.ToolTip>
                                             <Image Source="{Binding DisplayImageUrl}" Width="400" />
                                         </Image.ToolTip>
                                     </Image>
                                 </DataTemplate>
                             </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Ad" Width="220" DisplayMemberBinding="{Binding Channel.Name}" />
                        <GridViewColumn Header="Kategori" Width="80" DisplayMemberBinding="{Binding Channel.Category}" />
                        <GridViewColumn Header="Dil" Width="80" DisplayMemberBinding="{Binding Channel.Language}" />
                        <GridViewColumn Header="Bağlantı Sayısı" Width="100">
                             <GridViewColumn.CellTemplate>
                                 <DataTemplate>
                                     <TextBlock Text="{Binding UrlCount}" />
                                 </DataTemplate>
                             </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>
        </Grid>
        
        <StackPanel Grid.Column="1" Background="#1e293b" Margin="0,0,0,0">
            <TextBlock Text="Toplu İşlemler" FontSize="18" FontWeight="Bold" Margin="10" Foreground="#38bdf8" />
            
            <TextBlock Text="Kategori:" Margin="10,10,10,5" Foreground="#94a3b8" />
            <ComboBox x:Name="BulkCategoryCombo" Margin="10,0,10,10" Height="35">
                <ComboBoxItem Content="Değiştirme" IsSelected="True" />
                <ComboBoxItem Content="TV" />
                <ComboBoxItem Content="Film" />
                <ComboBoxItem Content="Dizi" />
                <ComboBoxItem Content="Radyo" />
            </ComboBox>
            
            <TextBlock Text="Dil (Ülke):" Margin="10,0,10,5" Foreground="#94a3b8" />
            <ComboBox x:Name="BulkLanguageCombo" Margin="10,0,10,10" Height="35" IsEditable="True" />
            
            <Button Content="Seçilileri Güncelle" Margin="10,10,10,20" Height="35" Background="#10b981" Foreground="White" BorderThickness="0" Click="BulkUpdateBtn_Click" Cursor="Hand" />
            <Separator Background="#334155" Margin="10,0" />
            
            <TextBlock Text="Birleştirme (Merge)" FontSize="16" FontWeight="Bold" Margin="10,20,10,10" Foreground="#f59e0b" />
            <TextBlock Text="Seçili kanalları TEK KANAL altında toplar. Logolar ve yayın adresleri birleştirilir." TextWrapping="Wrap" Margin="10,0,10,10" Foreground="#64748b" FontSize="11" />
            <Button Content="Seçilileri Birleştir" Margin="10,0,10,0" Height="35" Background="#f59e0b" Foreground="White" BorderThickness="0" Click="MergeBtn_Click" Cursor="Hand" />
            
            <TextBlock Text="Canlı Önizleme Görüntüsü Çek" FontSize="16" FontWeight="Bold" Margin="10,30,10,10" Foreground="#a855f7" />
            <TextBlock Text="Logosu olmayan kanal için FFmpeg ile yayından anlık tek kare çekip minik kapak (thumbnail) oluşturur. (Sürüklerken veya üzerine gelindiğinde büyür)." TextWrapping="Wrap" Margin="10,0,10,10" Foreground="#64748b" FontSize="11" />
            <Button x:Name="SnapshotBtn" Content="📸 Seçililerden Görüntü Al (Thumbnail)" Margin="10,0,10,0" Height="35" Background="#a855f7" Foreground="White" BorderThickness="0" Click="SnapshotBtn_Click" Cursor="Hand" />
            <TextBlock x:Name="JobStatusTxt" Text="Bekliyor..." Margin="10,10,10,0" Foreground="#cbd5e1" FontSize="11" />
        </StackPanel>
    </Grid>
</Window>
