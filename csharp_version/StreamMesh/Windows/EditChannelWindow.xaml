<Window x:Class="StreamMesh.Windows.EditChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanal Düzenle" Height="650" Width="400"
        Background="#0f172a" Foreground="#f8fafc"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Kanalı Düzenle" FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,15" />

            <TextBlock Text="Kanal Adı:" Foreground="#94a3b8" Margin="0,5,0,0"/>
            <TextBox x:Name="NameTxt" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="EPG ID (Kanal Eşleşme Adı):" Foreground="#94a3b8" Margin="0,5,0,0"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="EpgIdCombo" Height="38" VerticalContentAlignment="Center" IsEditable="True" 
                          ToolTip="EPG verisinde kanalın hangi adla eşleşeceğini manuel belirlemek için kullanın."/>
                <Button x:Name="FindEpgBtn" Grid.Column="1" Content="✨ Otomatik Bul" Width="100" Margin="5,0,0,0" 
                        Background="#3b82f6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="FindEpgBtn_Click"/>
            </Grid>

            <TextBlock Text="Yayın URL'leri (En üstteki varsayılandır):" Foreground="#94a3b8" Margin="0,5,0,0"/>
            <ListBox x:Name="UrlList" Height="100" Background="#1e293b" BorderThickness="1" BorderBrush="#334155" Margin="0,2,0,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#e2e8f0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="⭐" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Varsayılan Yap" 
                                        Click="MakeDefaultUrl_Click" Background="#334155" Foreground="#fbbf24" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="❌" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Sil" 
                                        Click="RemoveUrl_Click" Background="#334155" Foreground="#ef4444" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewUrlTxt" Height="38" VerticalContentAlignment="Center" Background="#1e293b" Foreground="White" BorderThickness="1" BorderBrush="#334155" Padding="5,0"/>
                <Button Grid.Column="1" Content="➕ Ekle" Width="70" Margin="5,0,0,0" Click="AddUrl_Click" 
                        Background="#10b981" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="Kategori:" Foreground="#94a3b8"/>
            <ComboBox x:Name="CatCombo" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,10" IsEditable="True">
                <ComboBoxItem Content="TV"/>
                <ComboBoxItem Content="Film"/>
                <ComboBoxItem Content="Dizi"/>
                <ComboBoxItem Content="Radyo"/>
            </ComboBox>

            <TextBlock Text="Dil (Language):" Foreground="#94a3b8"/>
            <ComboBox x:Name="LangCombo" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,10" IsEditable="True"/>

            <TextBlock Text="Grup (Group Title):" Foreground="#94a3b8"/>
            <TextBox x:Name="GroupTxt" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Kaynak Tipi (Source Type):" Foreground="#94a3b8"/>
            <TextBox x:Name="SourceTxt" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Logo URL'leri (En üstteki varsayılandır):" Foreground="#94a3b8" Margin="0,5,0,0"/>
            <ListBox x:Name="LogoList" Height="100" Background="#1e293b" BorderThickness="1" BorderBrush="#334155" Margin="0,2,0,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Mini preview for logos without crashing binding, bypassing LogoCacheConverter to avoid issues or using string direct -->
                            <Image Source="{Binding}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,5,0">
                                <Image.ToolTip>
                                    <Image Source="{Binding}" Width="300" />
                                </Image.ToolTip>
                            </Image>
                            <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Foreground="#e2e8f0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="⭐" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Varsayılan Yap" 
                                        Click="MakeDefaultLogo_Click" Background="#334155" Foreground="#fbbf24" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="❌" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Sil" 
                                        Click="RemoveLogo_Click" Background="#334155" Foreground="#ef4444" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewLogoTxt" Height="38" VerticalContentAlignment="Center" Background="#1e293b" Foreground="White" BorderThickness="1" BorderBrush="#334155" Padding="5,0"/>
                <Button Grid.Column="1" Content="➕ Ekle" Width="70" Margin="5,0,0,0" Click="AddLogo_Click" 
                        Background="#10b981" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <CheckBox x:Name="FavoriteChk" Content="Favorilere Ekle" Foreground="#fbbf24" FontSize="14" Margin="0,5,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="İptal" Width="80" Height="35" Background="#475569" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="CancelBtn_Click"/>
                <Button Content="Kaydet" Width="80" Height="35" Background="#38bdf8" Foreground="White" BorderThickness="0" Click="SaveBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
