<Window x:Class="StreamMesh.Windows.MissingComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eksik Bileşenler Tespit Edildi" Height="250" Width="450" 
        Background="#0f172a" Foreground="#f8fafc" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
    
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38bdf8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284c7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="⚠️ Eksik Ekipman Bildirimi" FontWeight="Bold" FontSize="18" Foreground="#ef4444" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="1" Text="Uygulamanızın sorunsuz çalışması için FFmpeg ve AceStream motorlarının indirilmesi gerekmektedir. İndirmek ister misiniz?" TextWrapping="Wrap" FontSize="14" Foreground="#cbd5e1" Margin="0,0,0,15"/>
        
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="" FontSize="12" Foreground="#38bdf8" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Daha Sonra" Width="100" Height="35" Margin="0,0,10,0" Click="CancelBtn_Click" Background="#475569" Foreground="White" BorderThickness="0"/>
            <Button x:Name="DownloadBtn" Content="Şimdi İndir" Width="120" Height="35" Click="DownloadBtn_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
