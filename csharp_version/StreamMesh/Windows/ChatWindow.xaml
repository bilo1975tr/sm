<Window x:Class="StreamMesh.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamMesh AI Asistan" Height="500" Width="450"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sohbet Mesajları Listesi -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel x:Name="MessagesList" VerticalAlignment="Bottom"/>
        </ScrollViewer>

        <!-- Canlı Durum Bilgisi Alanı (Yapay zeka o anda ne yapıyor) -->
        <Border Grid.Row="1" x:Name="StatusBorder" Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Küçük bir yanıp sönen simge gibi -->
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.8" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Düşünüyor..." Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Giriş Paneli -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Ayarlar" Click="Settings_Click" Width="70" Height="32" 
                    Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <TextBox Grid.Column="1" x:Name="InputPrompt" Height="32" Padding="8,5"
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                     CaretBrush="#F8FAFC" KeyDown="InputPrompt_KeyDown" VerticalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            
            <Button Grid.Column="2" x:Name="SendButton" Content="Gönder" Click="Send_Click" Width="70" Height="32"
                    Background="#2563EB" Foreground="#F8FAFC" BorderBrush="Transparent" Margin="8,0,0,0" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
