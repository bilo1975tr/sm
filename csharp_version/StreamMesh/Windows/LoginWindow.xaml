<Window x:Class="StreamMesh.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamMesh - Giriş / Kayıt" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0f172a" Foreground="#f8fafc">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="StreamMesh Ağına Katıl" FontSize="24" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Hesabınız yoksa otomatik oluşturulacaktır (P2P tabanlı)" FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="E-Posta Adresi" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Şifre" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Background="#1e293b" Foreground="#f8fafc" BorderBrush="#334155" Padding="10,8" Margin="0,0,0,15"/>

            <TextBlock Text="Bulunduğunuz Ülke" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <ComboBox x:Name="CountryCombo" Height="35" Margin="0,0,0,15" Background="#1e293b" Foreground="#0f172a">
                <ComboBoxItem Content="Türkiye" IsSelected="True"/>
                <ComboBoxItem Content="Almanya"/>
                <ComboBoxItem Content="Amerika"/>
                <ComboBoxItem Content="İngiltere"/>
            </ComboBox>

            <TextBlock Text="Diğer Bildiğiniz Diller" Foreground="#94a3b8" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Lang1Combo" Grid.Column="0" Height="35" Background="#1e293b" Foreground="#0f172a">
                    <ComboBoxItem Content="Seçili Değil" IsSelected="True"/>
                    <ComboBoxItem Content="İngilizce"/>
                    <ComboBoxItem Content="Almanca"/>
                </ComboBox>
                <ComboBox x:Name="Lang2Combo" Grid.Column="2" Height="35" Background="#1e293b" Foreground="#0f172a">
                    <ComboBoxItem Content="Seçili Değil" IsSelected="True"/>
                    <ComboBoxItem Content="İngilizce"/>
                    <ComboBoxItem Content="Almanca"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <Button Grid.Row="3" Content="Giriş Yap / Kayıt Ol" Height="45" Margin="0,20,0,0" Style="{DynamicResource PrimaryButtonStyle}" Click="Login_Click"/>
    </Grid>
</Window>
