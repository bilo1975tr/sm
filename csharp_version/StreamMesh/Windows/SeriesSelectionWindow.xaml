<Window x:Class="StreamMesh.Windows.SeriesSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dizi Seçici" Height="580" Width="750" Background="#0f172a"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Segoe UI" Foreground="#f8fafc">
    <!-- Resources for custom button / card styles -->
    <Window.Resources>
        <Style x:Key="SeasonButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#38bdf8"/>
                    <Setter Property="Foreground" Value="#0f172a"/>
                    <Setter Property="BorderBrush" Value="#38bdf8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#38bdf8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38bdf8"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0ea5e9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Header Info -->
            <RowDefinition Height="Auto"/>
            <!-- Hero Continue Watching -->
            <RowDefinition Height="Auto"/>
            <!-- Seasons Selector -->
            <RowDefinition Height="Auto"/>
            <!-- Episodes Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="🎬" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0"/>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SeriesTitleText" Text="Dizi Adı" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Border Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="SeriesSeasonsCountText" Text="0 Sezon" FontSize="11" Foreground="#94a3b8" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="SeriesEpisodesCountText" Text="0 Bölüm" FontSize="11" Foreground="#94a3b8" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="SeriesLanguageText" Text="Türkçe" FontSize="11" Foreground="#38bdf8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Content="❌ Kapat" Width="75" Height="28" Background="#ef4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="CloseBtn_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Hero Resume Watching Panel -->
        <Border x:Name="ResumeWatchingPanel" Grid.Row="1" Background="#1e1b4b" BorderBrush="#4f46e5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,5,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🕒 KALDIĞIN YERDEN DEVAM ET" FontSize="11" FontWeight="Bold" Foreground="#818cf8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ResumeEpisodeNameText" Text="Sezon 1 Bölüm 2" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="İzlenen yer: " FontSize="12" Foreground="#94a3b8"/>
                        <TextBlock x:Name="ResumeTimeText" Text="12:34 / 45:00" FontSize="12" Foreground="#cbd5e1" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ResumePercentText" Text="%45" FontSize="12" Foreground="#38bdf8" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="▶ İzlemeye Devam Et" Style="{StaticResource PlayButtonStyle}" Click="ResumeWatchingBtn_Click" VerticalAlignment="Center" Padding="16,10"/>
            </Grid>
        </Border>

        <!-- Seasons Panel -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Sezon Seçin" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,6"/>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SeasonsContainer" Orientation="Horizontal" Margin="0,2,0,5"/>
            </ScrollViewer>
        </Grid>

        <!-- Episodes Panel -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Bölümler" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,6"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="EpisodesContainer" Orientation="Horizontal" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
