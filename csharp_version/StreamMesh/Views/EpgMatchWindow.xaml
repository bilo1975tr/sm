<Window x:Class="StreamMesh.Views.EpgMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EPG Akıllı Eşleştirme Yardımcısı" Height="700" Width="1000" Background="#0f172a" 
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Foreground="#f8fafc">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Stats Bar -->
            <RowDefinition Height="*"/>    <!-- Content split -->
            <RowDefinition Height="Auto"/> <!-- Action Panel -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🔗 EPG Akıllı Eşleştirme Yardımcısı" FontSize="20" FontWeight="Bold" Foreground="#38bdf8"/>
                <TextBlock Text="Kanallarınızı yüklü XMLTV kaynaklarındaki programlar ile eşleştirin." FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SafeAutoMatchBtn" Content="⚡ Güvenli Otomatik Eşleştir" Height="35" Width="200" Click="SafeAutoMatchBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#22c55e" Foreground="White" FontWeight="Bold" Cursor="Hand" ToolTip="Aynı normalize isim ve aynı dile sahip kanalları otomatik eşleştirir."/>
        </Grid>

        <!-- Stats Bar -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="8" Padding="12,8" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Toplam Kanal" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalChannels" Text="0" FontSize="16" FontWeight="Bold" Foreground="#e2e8f0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="EPG Eşleşen" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMatchedChannels" Text="0" FontSize="16" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="EPG Eksik" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMissingChannels" Text="0" FontSize="16" FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Kayıtlı EPG Kanalları" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEpgChannels" Text="0" FontSize="16" FontWeight="Bold" Foreground="#a855f7" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Split -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Local Channels -->
            <Border Grid.Column="0" Background="#111827" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="📺 Yerel Kanallarınız" FontSize="14" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,10"/>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SearchLocalBox" Height="32" Padding="5,4" Background="#1f2937" Foreground="White" BorderBrush="#334155" TextChanged="SearchLocalBox_TextChanged" ToolTip="Kanal ara..."/>
                        <CheckBox Grid.Column="1" x:Name="ChkOnlyMissing" Content="Yalnızca Eşleşmeyenler" Foreground="#94a3b8" VerticalAlignment="Center" Margin="10,0,0,0" Checked="ChkOnlyMissing_Changed" Unchecked="ChkOnlyMissing_Changed"/>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="LocalChannelsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="LocalChannelsListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1f2937" CornerRadius="6" Padding="8" Margin="0,2" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Language}" FontSize="11" Foreground="#94a3b8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,3" Background="#111827" VerticalAlignment="Center" Margin="5,0,0,0">
                                            <TextBlock Text="{Binding EpgStatusText}" Foreground="{Binding EpgStatusColor}" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#334155"/>

            <!-- Right Panel: EPG XMLTV Channels -->
            <Border Grid.Column="2" Background="#111827" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="📋 XMLTV EPG Kanalları" FontSize="14" FontWeight="Bold" Foreground="#f8fafc" Margin="0,0,0,10"/>
                    
                    <TextBox Grid.Row="1" x:Name="SearchEpgBox" Height="32" Padding="5,4" Background="#1f2937" Foreground="White" BorderBrush="#334155" TextChanged="SearchEpgBox_TextChanged" Margin="0,0,0,8" ToolTip="EPG kanalı ara..."/>

                    <ListBox Grid.Row="2" x:Name="EpgChannelsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="EpgChannelsListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1f2937" CornerRadius="6" Padding="8" Margin="0,2" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SourceUrl}" FontSize="10" Foreground="#64748b" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="350"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,3" Background="#111827" VerticalAlignment="Center" Margin="5,0,0,0">
                                            <TextBlock Text="{Binding InferredLanguage}" Foreground="#a855f7" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Panel -->
        <Border Grid.Row="3" Background="#1e293b" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recommendation & Details -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Seçili Yerel Kanal: " Foreground="#94a3b8" FontSize="13"/>
                        <TextBlock x:Name="TxtSelectedLocalChannel" Text="Seçim Yok" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="RecommendationPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="💡 Akıllı Öneri: " Foreground="#f59e0b" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtRecommendedEpg" Text="Öneri bulunamadı" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Button x:Name="ApplyRecommendationBtn" Content="Öneriyi Uygula" Padding="8,2" FontSize="11" Click="ApplyRecommendationBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#d97706" Foreground="White"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UnlinkBtn" Content="Eşleşmeyi Kaldır" Width="130" Height="35" Margin="0,0,10,0" Click="UnlinkBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Foreground="#fca5a5" Visibility="Collapsed"/>
                    <Button x:Name="LinkBtn" Content="Seçili EPG'ye Eşleştir" Width="180" Height="35" Click="LinkBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#3b82f6" Foreground="White" FontWeight="SemiBold" Cursor="Hand" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
