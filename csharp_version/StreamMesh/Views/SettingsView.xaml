<UserControl x:Class="StreamMesh.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:StreamMesh.Services"
             Background="Transparent" Foreground="#f8fafc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Title]}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="15,10" Margin="0,0,5,5" Background="#1e293b" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="5,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#38bdf8" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#0284c7" />
                                        <Setter Property="Foreground" Value="#0f172a" />
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#334155" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_TabResource]}">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_AddStream]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_LinkType]}" VerticalAlignment="Center" Width="120" Foreground="#94a3b8"/>
                            <TextBox x:Name="M3uUrlTextBox" Width="240" Height="35" Margin="0,0,10,0" ToolTip="M3U/DPL Linki, AceStream ID veya YouTube Linki girebilirsiniz."/>
                            <Button x:Name="BrowseM3uBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Browse]}" Width="60" Height="35" Click="BrowseM3uBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Background="#475569"/>
                            <ComboBox x:Name="DefaultCategoryCombo" Width="90" Height="35" VerticalContentAlignment="Center" Margin="0,0,10,0">
                                <ComboBoxItem Content="Otomatik" IsSelected="True"/>
                                <ComboBoxItem Content="TV"/>
                                <ComboBoxItem Content="Film"/>
                                <ComboBoxItem Content="Dizi"/>
                            </ComboBox>
                            <Button x:Name="AddM3uButton" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Load]}" Width="80" Height="35" Click="AddM3uButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="M3uStatusText" Foreground="#94a3b8" Margin="0,10,0,10" TextWrapping="Wrap"/>
                        
                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_AddedStreams]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <ListBox x:Name="M3uSourcesList" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Height="180" Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Url}" FontWeight="Bold" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                            <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Reload]}" Click="ReloadSource_Click" 
                                                Padding="10,4" FontSize="11" Margin="10,0,0,0" 
                                                Style="{StaticResource PrimaryButtonStyle}" Background="#334155" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_EditSrc]}" Click="EditSource_Click"/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Reload]}" Click="ReloadSource_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_DelSrc]}" Click="RemoveM3uSourceBtn_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Button x:Name="RemoveM3uSourceBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_DelSelectedSrc]}" Width="150" Height="35" Margin="0,10,0,0" HorizontalAlignment="Left" Click="RemoveM3uSourceBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Foreground="#fca5a5" />

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_StreamCheck]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_StreamCheckDesc]}" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="CheckAllStreamsBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_CheckAll]}" Width="200" Height="40" Margin="0,0,10,0"
                                    Click="CheckAllStreamsBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#3b82f6" Foreground="White" />
                            <Button x:Name="CheckUnverifiedStreamsBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_CheckUnverified]}" Width="220" Height="40"
                                    Click="CheckUnverifiedStreamsBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#0ea5e9" Foreground="White" />
                        </StackPanel>
                        <TextBlock x:Name="StreamCheckStatusText" Foreground="#cbd5e1" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_DataMgmt]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="OptimizeLibraryBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_OptLib]}" Width="220" Height="40" Margin="0,0,10,0"
                                    Click="OptimizeLibraryBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#059669" 
                                    Foreground="White" ToolTip="Çift kanalları birleştirir ve URL listelerini temizler." />
                            <Button x:Name="ClearChannelsButton" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_ResetChannels]}" Width="220" Height="40"
                                    Click="ClearChannelsButton_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" 
                                    Foreground="#fca5a5" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="🎨 Logo Tanımlama ve Eşleştirme" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="Logosu olmayan tüm kanallar için bulut (iptv-org) veritabanından akıllı ve otomatik logo araması yapar." Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AutoMatchLogosBtn" Content="Eksik Logoları Otomatik Eşleştir" Width="240" Height="40" Margin="0,0,10,0"
                                    Click="AutoMatchLogosBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#8b5cf6" Foreground="White" />
                        </StackPanel>
                        <TextBlock x:Name="LogoMatchStatusText" Foreground="#cbd5e1" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_TabEpg]}">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_AddEpg]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_EpgUrl]}" VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <TextBox x:Name="EpgUrlTextBox" Width="270" Height="35" Margin="0,0,10,0"/>
                            <Button x:Name="BrowseEpgBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Browse]}" Width="80" Height="35" Click="BrowseEpgBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Background="#475569"/>
                            <Button x:Name="AddEpgButton" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Load]}" Width="100" Height="35" Click="AddEpgButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="EpgStatusText" Foreground="#94a3b8" Margin="0,10,0,10" />

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_AddedEpgs]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <ListBox x:Name="EpgSourcesList" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Height="150" Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Url}" FontWeight="Bold" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Reload]}" Click="ReloadEpgSource_Click" 
                                                Padding="10,4" FontSize="11" Margin="10,0,0,0" 
                                                Style="{StaticResource PrimaryButtonStyle}" Background="#334155" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_Reload]}" Click="ReloadEpgSource_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_DelSelectedEpg]}" Click="RemoveEpgSourceBtn_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Button x:Name="RemoveEpgSourceBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_DelSelectedEpg]}" Width="150" Height="35" Margin="0,10,0,0" HorizontalAlignment="Left" Click="RemoveEpgSourceBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Foreground="#fca5a5" />

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>

                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_DataMgmt]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <Button x:Name="ClearEpgsButton" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_ResetEpgs]}" Width="220" Height="40" HorizontalAlignment="Left"
                                Click="ClearEpgsButton_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" 
                                Foreground="#fca5a5" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_TabApp], FallbackValue='Uygulama'}">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_AppLang], FallbackValue='Uygulama Dili'}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_AppLangDesc], FallbackValue='Uygulamanın arayüz dilini buradan değiştirebilirsiniz.'}" Foreground="#94a3b8" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_LangSelect], FallbackValue='Dil Seçimi'}" VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <ComboBox x:Name="LanguageCombo" Width="200" Height="35" SelectionChanged="LanguageCombo_SelectionChanged" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Türkçe" Tag="Türkçe"/>
                                <ComboBoxItem Content="English" Tag="English"/>
                                <ComboBoxItem Content="Deutsch" Tag="Deutsch"/>
                                <ComboBoxItem Content="Français" Tag="Français"/>
                                <ComboBoxItem Content="Español" Tag="Español"/>
                                <ComboBoxItem Content="Italiano" Tag="Italiano"/>
                                <ComboBoxItem Content="Português" Tag="Português"/>
                                <ComboBoxItem Content="Pусский" Tag="Pусский"/>
                                <ComboBoxItem Content="العربية" Tag="العربية"/>
                                <ComboBoxItem Content="中文" Tag="中文"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <!-- Country Settings -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Country], FallbackValue='Bulunduğunuz Ülke'}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="Bulut senkronizasyonu ve içerik filtrelemede varsayılan olarak bu ülke dili baz alınacaktır." Foreground="#94a3b8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Country], FallbackValue='Ülke Seçimi'}" VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <ComboBox x:Name="CountryCombo" Width="200" Height="35" SelectionChanged="ProfileCombo_SelectionChanged" VerticalContentAlignment="Center" Background="#1e293b" Foreground="#0f172a" />
                        </StackPanel>

                        <!-- Extra Languages -->
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[KnownLangs], FallbackValue='Bildiğiniz Diğer Diller'}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,20,0,10"/>
                        <TextBlock Text="Bu dillerdeki içerikler de size gösterilecektir." Foreground="#94a3b8" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Ek Dil 1" VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <ComboBox x:Name="Lang1Combo" Width="200" Height="35" SelectionChanged="ProfileCombo_SelectionChanged" VerticalContentAlignment="Center" Background="#1e293b" Foreground="#0f172a"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Ek Dil 2" VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <ComboBox x:Name="Lang2Combo" Width="200" Height="35" SelectionChanged="ProfileCombo_SelectionChanged" VerticalContentAlignment="Center" Background="#1e293b" Foreground="#0f172a"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>

                        <!-- Component Management -->
                        <TextBlock Text="🚨 Bileşen Yönetimi" FontWeight="Bold" FontSize="18" Foreground="#ef4444" Margin="0,0,0,10"/>
                        <TextBlock Text="FFmpeg veya Ace Stream motorunuz eksikse donanımları veya OSD yeteneklerini tam kullanamazsınız." Foreground="#94a3b8" Margin="0,0,0,10"/>
                        
                        <StackPanel Margin="0,5,0,20">
                            <!-- Tümünü İndir -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="DownloadAllComponentsBtn" Content="Tüm Eksikleri İndir" Width="150" Height="35" Click="DownloadAllComponentsBtn_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                                <TextBlock x:Name="DownloadStatusText" Text="" VerticalAlignment="Center" Foreground="#38bdf8" Margin="15,0,0,0"/>
                            </StackPanel>

                            <!-- FFmpeg -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="DownloadFFmpegBtn" Content="FFmpeg İndir" Width="150" Height="35" Click="DownloadFFmpegBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#3b82f6"/>
                                <Ellipse x:Name="FFmpegStatusIndicator" Width="12" Height="12" Fill="#ef4444" Margin="15,0,5,0" />
                                <TextBlock x:Name="FFmpegStatusText" Text="FFmpeg Yüklü Değil" VerticalAlignment="Center" Foreground="#94a3b8"/>
                            </StackPanel>

                            <!-- AceStream -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="DownloadAceStreamBtn" Content="AceStream İndir" Width="150" Height="35" Click="DownloadAceStreamBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#6366f1"/>
                                <Ellipse x:Name="AceStreamStatusIndicator" Width="12" Height="12" Fill="#ef4444" Margin="15,0,5,0" />
                                <TextBlock x:Name="AceStreamStatusText" Text="AceStream Yüklü Değil" VerticalAlignment="Center" Foreground="#94a3b8"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_TabNetwork]}">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_NetLocal]}" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_NetDesc]}" Foreground="#94a3b8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,20">
                            <Button x:Name="ServerControlBtn" Content="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Set_StartServer]}" Width="150" Height="35" Click="ServerControlBtn_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <TextBlock x:Name="ServerStatusText" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Status_Off]}" VerticalAlignment="Center" Foreground="#fca5a5" Margin="15,0,0,0"/>
                            <TextBox x:Name="ServerUrlBox" Width="250" Height="35" Margin="15,0,0,0" IsReadOnly="True" Background="#0f172a" Foreground="#38bdf8" BorderBrush="#334155"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
