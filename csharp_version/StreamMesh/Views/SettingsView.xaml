<UserControl x:Class="StreamMesh.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="#f8fafc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ayarlar" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="15,10" Margin="0,0,5,5" Background="#1e293b" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="5,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#38bdf8" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#0284c7" />
                                        <Setter Property="Foreground" Value="#0f172a" />
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#334155" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Kaynaklar / Yayın">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Yeni Oynatma Listesi Kaynağı Ekle" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="M3U / DPL / Link: " VerticalAlignment="Center" Width="120" Foreground="#94a3b8"/>
                            <TextBox x:Name="M3uUrlTextBox" Width="240" Height="35" Margin="0,0,10,0" ToolTip="M3U/DPL Linki, AceStream ID veya YouTube Linki girebilirsiniz."/>
                            <Button x:Name="BrowseM3uBtn" Content="Gözat" Width="60" Height="35" Click="BrowseM3uBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Background="#475569"/>
                            <ComboBox x:Name="DefaultCategoryCombo" Width="90" Height="35" VerticalContentAlignment="Center" Margin="0,0,10,0">
                                <ComboBoxItem Content="Otomatik" IsSelected="True"/>
                                <ComboBoxItem Content="TV"/>
                                <ComboBoxItem Content="Film"/>
                                <ComboBoxItem Content="Dizi"/>
                            </ComboBox>
                            <Button x:Name="AddM3uButton" Content="Yükle" Width="80" Height="35" Click="AddM3uButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="M3uStatusText" Foreground="#94a3b8" Margin="0,10,0,10" TextWrapping="Wrap"/>
                        
                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="Ekli Oynatma Listeleri" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <ListBox x:Name="M3uSourcesList" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Height="180" Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Url}" FontWeight="Bold" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                            <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔄 Yeniden Yükle" Click="ReloadSource_Click" 
                                                Padding="10,4" FontSize="11" Margin="10,0,0,0" 
                                                Style="{StaticResource PrimaryButtonStyle}" Background="#334155" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kaynağı Düzenle (Diller vs)" Click="EditSource_Click"/>
                                    <MenuItem Header="Kaynağı Yeniden Yükle" Click="ReloadSource_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Kaynağı Sil" Click="RemoveM3uSourceBtn_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Button x:Name="RemoveM3uSourceBtn" Content="Seçili Kaynağı Sil" Width="150" Height="35" Margin="0,10,0,0" HorizontalAlignment="Left" Click="RemoveM3uSourceBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Foreground="#fca5a5" />

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="Kanal/Yayın Doğrulama" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="IPTV yayınlarının aktif olup olmadığını kontrol edebilirsiniz. Çalışmayanlar silinir." Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="CheckAllStreamsBtn" Content="Tüm Kanalları Kontrol Et" Width="200" Height="40" Margin="0,0,10,0"
                                    Click="CheckAllStreamsBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#3b82f6" Foreground="White" />
                            <Button x:Name="CheckUnverifiedStreamsBtn" Content="Onaysız Yayınları Kontrol Et" Width="220" Height="40"
                                    Click="CheckUnverifiedStreamsBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#0ea5e9" Foreground="White" />
                        </StackPanel>
                        <TextBlock x:Name="StreamCheckStatusText" Foreground="#cbd5e1" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="Veri Yönetimi" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OptimizeLibraryBtn" Content="✨ Kütüphaneyi Optimize Et" Width="220" Height="40" Margin="0,0,10,0"
                                    Click="OptimizeLibraryBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#059669" 
                                    Foreground="White" ToolTip="Çift kanalları birleştirir ve URL listelerini temizler." />
                            <Button x:Name="ClearChannelsButton" Content="🚨 Tüm Kanalları Sıfırla" Width="220" Height="40"
                                    Click="ClearChannelsButton_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" 
                                    Foreground="#fca5a5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Kaynaklar / EPG">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Yeni EPG Kaynağı Ekle" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="EPG URL veya Dosya: " VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <TextBox x:Name="EpgUrlTextBox" Width="270" Height="35" Margin="0,0,10,0"/>
                            <Button x:Name="BrowseEpgBtn" Content="Gözat" Width="80" Height="35" Click="BrowseEpgBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Background="#475569"/>
                            <Button x:Name="AddEpgButton" Content="EPG Yükle" Width="100" Height="35" Click="AddEpgButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="EpgStatusText" Foreground="#94a3b8" Margin="0,10,0,10" />

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>
                        
                        <TextBlock Text="Ekli EPG Listeleri" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <ListBox x:Name="EpgSourcesList" Background="#0f172a" Foreground="#f8fafc" BorderBrush="#334155" Height="150" Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Url}" FontWeight="Bold" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔄 Yeniden Yükle" Click="ReloadEpgSource_Click" 
                                                Padding="10,4" FontSize="11" Margin="10,0,0,0" 
                                                Style="{StaticResource PrimaryButtonStyle}" Background="#334155" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kaynağı Yeniden Yükle" Click="ReloadEpgSource_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Kaynağı Sil" Click="RemoveEpgSourceBtn_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <Button x:Name="RemoveEpgSourceBtn" Content="Seçili EPG'yi Sil" Width="150" Height="35" Margin="0,10,0,0" HorizontalAlignment="Left" Click="RemoveEpgSourceBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Foreground="#fca5a5" />

                        <Rectangle Height="1" Fill="#334155" Margin="0,15"/>

                        <TextBlock Text="Veri Yönetimi" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <Button x:Name="ClearEpgsButton" Content="🚨 Tüm EPG Verisini Sıfırla" Width="220" Height="40" HorizontalAlignment="Left"
                                Click="ClearEpgsButton_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" 
                                Foreground="#fca5a5" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Oynatıcı Ayarları">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Oynatıcı Ayarları (VLC &amp; AceStream)" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="AceStream Engine: " VerticalAlignment="Center" Width="150" Foreground="#94a3b8"/>
                            <Button x:Name="AceStartBtn" Content="Motoru Başlat" Width="120" Height="35" Click="AceStartBtn_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AceStatusText" Text="Durum: Kapalı" VerticalAlignment="Center" Foreground="#94a3b8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Sistem / Ağ Ayarları">
                <Border Background="#1e293b" Padding="20" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Ağ &amp; Yerel Sunucu M3U" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <TextBlock Text="Smart TV veya TiviMate gibi uygulamalar için bu adresi kullanabilirsiniz." Foreground="#94a3b8" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,20">
                            <Button x:Name="ServerControlBtn" Content="Sunucuyu Başlat" Width="150" Height="35" Click="ServerControlBtn_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <TextBlock x:Name="ServerStatusText" Text="Durum: Kapalı" VerticalAlignment="Center" Foreground="#fca5a5" Margin="15,0,0,0"/>
                            <TextBox x:Name="ServerUrlBox" Width="250" Height="35" Margin="15,0,0,0" IsReadOnly="True" Background="#0f172a" Foreground="#38bdf8" BorderBrush="#334155"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
