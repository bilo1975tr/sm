<UserControl x:Class="StreamMesh.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:services="clr-namespace:StreamMesh.Services"
             Background="Black">
    <UserControl.Resources>
        <!-- Modern Web Player Slider Style -->
        <Style x:Key="WebPlayerSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#33ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="TrackBackground" Height="4" Background="{TemplateBinding Background}" VerticalAlignment="Center" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#38bdf8" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#38bdf8" StrokeThickness="2" Width="14" Height="14" Margin="-2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PlayerContainer">

        <!-- Alternative 2: Memory Rendering (Pure WPF Image) eliminates Airspace issues -->
        <Image x:Name="VideoImage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
               Stretch="Uniform" />

        <!-- Radio Mode Canvas / Overlay -->
        <Grid x:Name="RadioOverlayGrid" Visibility="Collapsed">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#0f172a" Offset="0.0"/>
                    <GradientStop Color="#020617" Offset="1.0"/>
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Weather panel integrated into Radio background -->
            <Grid Margin="30" VerticalAlignment="Top" HorizontalAlignment="Right" x:Name="RadioWeatherPanel">
                <Border CornerRadius="12" Background="#cc1e293b" BorderBrush="#38bdf8" BorderThickness="1" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RadioWeatherIcon" Text="☀️" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RadioWeatherTemp" Text="Yükleniyor..." FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="RadioWeatherCity" Text="İstanbul" FontSize="11" Foreground="#94a3b8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Centered Content -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Glowing Radio Icon and Vinyl Disk -->
                <Border Grid.Row="0" Width="180" Height="180" CornerRadius="90" BorderBrush="#38bdf8" BorderThickness="4" Background="#111827" Margin="0,0,0,25" x:Name="VinylDisk">
                    <Border.Effect>
                        <DropShadowEffect Color="#38bdf8" BlurRadius="30" ShadowDepth="0" Direction="0"/>
                    </Border.Effect>
                    <Grid>
                        <Border Width="140" Height="140" CornerRadius="70" BorderBrush="#4b5563" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="110" Height="110" CornerRadius="55" BorderBrush="#4b5563" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="80" Height="80" CornerRadius="40" BorderBrush="#38bdf8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1e293b"/>
                        <TextBlock Text="📻" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="RadioCenterIcon" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="VinylRotation" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Radio Station Name and Description -->
                <TextBlock x:Name="RadioStationName" Grid.Row="1" Text="Radyo Kanalı" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5" TextAlignment="Center"/>
                <TextBlock x:Name="RadioStatusText" Grid.Row="2" Text="CANLI RADYO YAYINI" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,0,0,20" LetterSpacing="2"/>

                <!-- Dynamic Audio Spectrum Visualizer -->
                <StackPanel x:Name="VisualizerPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Height="50" Margin="0,5,0,0">
                    <Rectangle Fill="#38bdf8" Width="4" Height="15" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar0"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="25" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar1"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="40" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar2"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="30" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar3"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="15" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar4"/>
                    <Rectangle Fill="#06b6d4" Width="4" Height="20" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar5"/>
                    <Rectangle Fill="#06b6d4" Width="4" Height="35" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar6"/>
                    <Rectangle Fill="#06b6d4" Width="4" Height="45" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar7"/>
                    <Rectangle Fill="#06b6d4" Width="4" Height="30" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar8"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="18" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar9"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="32" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar10"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="42" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar11"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="25" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar12"/>
                    <Rectangle Fill="#38bdf8" Width="4" Height="12" Margin="2" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" x:Name="Bar13"/>
                </StackPanel>
            </Grid>

            <!-- RSS News Ticker Overlay (at the bottom) -->
            <Border VerticalAlignment="Bottom" Height="45" Background="#cc0f172a" BorderBrush="#2238bdf8" BorderThickness="0,1,0,0">
                <Grid x:Name="TickerGrid" ClipToBounds="True">
                    <TextBlock x:Name="NewsTickerText" Text="Haberler alınıyor..." Foreground="#cbd5e1" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay OSD Grid - Set to catch all inputs -->
        <Grid x:Name="OsdGrid" IsHitTestVisible="True" Background="#01000000" 
              MouseMove="OsdGrid_MouseMove" MouseDown="OsdGrid_MouseDown" Panel.ZIndex="10">
            
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Tam Ekran (Çift Tıklama)" Click="FullscreenBtn_Click" />
                    <MenuItem Header="Duraklat/Devam Et" Click="PlayPauseBtn_Click" />
                    <MenuItem Header="Durdur" Click="StopBtn_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- Top Panel: Premium EPG OSD -->
            <Border x:Name="TopOsd" VerticalAlignment="Top" Margin="20" Padding="15,10" CornerRadius="12"
                    Background="#B20f172a" BorderBrush="#44ffffff" BorderThickness="1" Visibility="Collapsed" Height="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MenuBtn" Content="☰" Grid.Column="0" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Click="MenuBtn_Click" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Channel Logo and Name -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Border Width="60" Height="60" CornerRadius="8" Background="#33ffffff" Margin="0,0,15,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="📺" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94a3b8"/>
                                <Image x:Name="OsdChannelLogo" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="120">
                            <TextBlock x:Name="OsdTitle" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Player_Loading]}" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OsdCategory" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Player_NoCategory]}" FontSize="11" Foreground="#38bdf8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- EPG Info (Current & Next) -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Current Program -->
                        <TextBlock x:Name="OsdCurrentEpgTime" Grid.Row="0" Text="00:00 - 00:00" FontSize="12" Foreground="#38bdf8" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock x:Name="OsdCurrentEpgTitle" Grid.Row="1" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Player_EpgWait]}" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        
                        <!-- Progress Bar & Next Program -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="EpgProgressBar" Grid.Column="0" Height="4" Minimum="0" Maximum="100" Value="0" Background="#33ffffff" Foreground="#38bdf8" BorderThickness="0" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OsdNextEpg" Grid.Column="1" Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=[Player_NextEpgWait]}" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Embedded Weather in Top OSD -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" x:Name="WeatherPanel" Visibility="Collapsed">
                        <TextBlock Text="🌤️" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherTemp" Text="24°C" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock x:Name="WeatherCity" Text="İstanbul" FontSize="12" Foreground="#cbd5e1" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ad Banner Panel -->
            <Border x:Name="OsdAdBanner" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,100" Padding="15" CornerRadius="12"
                    Background="#D91e293b" BorderBrush="#38bdf8" BorderThickness="2" Visibility="Collapsed" MaxWidth="700">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="⭐" FontSize="40" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Duyuru &amp; Kampanyalar" FontWeight="Bold" FontSize="18" Foreground="#38bdf8" Margin="0,0,0,5" />
                        <TextBlock x:Name="AdBannerText" Text="Reklam yükleniyor..." FontSize="14" Foreground="#f8fafc" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Panel -->
            <Border x:Name="BottomOsd" VerticalAlignment="Bottom" Margin="20" Padding="15" CornerRadius="12"
                    Background="#990f172a" BorderBrush="#33ffffff" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayPauseBtn" Content="⏸" Grid.Column="0" Width="50" Height="50" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="24" Click="PlayPauseBtn_Click" Cursor="Hand" />
                    <Button x:Name="StopBtn" Content="⏹" Grid.Column="1" Width="40" Height="40" Background="Transparent" Foreground="#fca5a5" BorderThickness="0" FontSize="20" Click="StopBtn_Click" Cursor="Hand" />
                    
                    <TextBlock x:Name="TimeTextBlock" Grid.Column="2" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="10,0" Foreground="White" FontSize="11" />
                    
                    <Slider x:Name="SeekSlider" Grid.Column="3" VerticalAlignment="Center" Margin="10,0" Minimum="0" Maximum="100" Value="0" 
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            Style="{StaticResource WebPlayerSliderStyle}"
                            IsMoveToPointEnabled="True" Cursor="Hand" />

                    <TextBlock x:Name="StatusTextBlock" Grid.Column="4" Text="" VerticalAlignment="Center" Margin="10,0" Foreground="#38bdf8" MaxWidth="100" TextTrimming="CharacterEllipsis" />

                    <Button x:Name="OsnBtn" Content="🔊 OSN" Grid.Column="5" Width="55" Height="40" Background="#33ffffff" Foreground="White" BorderThickness="0" FontSize="10" Click="OsnBtn_Click" Margin="0,0,5,0" Cursor="Hand" ToolTip="Otomatik Ses Normalizasyonu" />
                    <Button x:Name="GoBtn" Content="✨ GO" Grid.Column="6" Width="55" Height="40" Background="#33ffffff" Foreground="White" BorderThickness="0" FontSize="10" Click="GoBtn_Click" Margin="0,0,5,0" Cursor="Hand" ToolTip="Görüntü Onarıcı / Netleştirme" />
                    <Button x:Name="QualityBtn" Content="⚙ Kalite" Grid.Column="7" Width="60" Height="40" Background="#33ffffff" Foreground="White" BorderThickness="0" FontSize="10" Click="QualityBtn_Click" Margin="0,0,5,0" Cursor="Hand" ToolTip="Yayın Kalitesi / Çözünürlük">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="QualityMenu" Background="#1e293b" Foreground="White" BorderThickness="0">
                                <!-- Dinamik dolacak -->
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Volume slider mockup -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="🔊" FontSize="16" Foreground="White" Margin="0,0,5,0" />
                        <Slider x:Name="VolumeSlider" Width="60" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <!-- Ratio Button -->
                    <Button x:Name="RatioBtn" Content="🖥 Ratio" Grid.Column="9" Width="60" Height="40" Background="#33ffffff" Foreground="White" BorderThickness="0" FontSize="10" Click="RatioBtn_Click" Margin="0,0,5,0" Cursor="Hand" ToolTip="En-Boy Oranı" />

                    <!-- Source Selection Button -->
                    <Button x:Name="SourceBtn" Content="🔗 Kaynak" Grid.Column="10" Width="60" Height="40" Background="#33ffffff" Foreground="White" BorderThickness="0" FontSize="10" Click="SourceBtn_Click" Margin="0,0,10,0" Cursor="Hand" ToolTip="Yayın Kaynağı / Alternatif Linkler">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SourceMenu" Background="#1e293b" Foreground="White" BorderThickness="0">
                                <!-- Dinamik dolacak -->
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Fullscreen Button -->
                    <Button x:Name="FullscreenBtn" Content="⛶" Grid.Column="11" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Click="FullscreenBtn_Click" Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Left Panel: Channel List -->
            <Border x:Name="SidebarBorder" HorizontalAlignment="Left" Width="300" Margin="20,90,0,90" Padding="10" CornerRadius="12"
                    Background="#eb0f172a" BorderBrush="#33ffffff" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBox x:Name="OsdSearchBox" Padding="8,5" Background="#1e293b" Foreground="White" BorderBrush="#334155" BorderThickness="1" TextChanged="OsdSearchBox_TextChanged" Margin="0,0,0,5" />
                        <ComboBox x:Name="OsdCategoryBox" Background="#1e293b" Foreground="White" BorderThickness="0" Padding="5" SelectionChanged="OsdCategoryBox_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#1e293b"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#38bdf8"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="Tümü" IsSelected="True"/>
                            <ComboBoxItem Content="Favoriler"/>
                            <ComboBoxItem Content="TV"/>
                            <ComboBoxItem Content="Film"/>
                            <ComboBoxItem Content="Dizi"/>
                            <ComboBoxItem Content="Radyo"/>
                        </ComboBox>
                    </StackPanel>

                    <ListView x:Name="ChannelListView" Grid.Row="1" Background="Transparent" Foreground="#f8fafc" BorderBrush="Transparent" SelectionChanged="ChannelListView_SelectionChanged" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e293b" CornerRadius="8" Margin="0,0,0,8" Padding="10" BorderThickness="1" BorderBrush="#334155" x:Name="ItemBorder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📺" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis" Width="220" FontSize="13"/>
                                        <TextBlock Text="{Binding GroupTitle}" FontSize="10" Foreground="#94a3b8" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#334155" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="SelectionBorder" BorderThickness="4,1,1,1" BorderBrush="Transparent" CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#38bdf8" />
                                                <Setter TargetName="SelectionBorder" Property="Background" Value="#1a38bdf8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
