<UserControl x:Class="StreamMesh.UI.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:StreamMesh.Converters"
             xmlns:flyleaf="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <conv:LogoCacheConverter x:Key="LogoCacheConverter" />

        <!-- Elegant OSD Button Style -->
        <Style x:Key="OsdControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="26" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Black" x:Name="PlayerGrid">
        <!-- FlyleafHost: The raw video surface -->
        <flyleaf:FlyleafHost x:Name="VideoPlayer" Background="Black">
            <!-- Overlay Container (Single Child for FlyleafHost compatibility) -->
            <Grid Background="Transparent" x:Name="PlayerOverlay">
                <!-- OSD Panel -->
                <Border VerticalAlignment="Bottom" Height="Auto" Background="#E60F172A" Margin="40" CornerRadius="20" BorderBrush="#334155" BorderThickness="1.5"
                        x:Name="OsdPanel" Visibility="Collapsed" MouseEnter="OsdPanel_MouseEnter" MouseLeave="OsdPanel_MouseLeave">
                    <Grid Margin="20,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Channel Logo -->
                            <Border Width="64" Height="64" Background="#1e293b" CornerRadius="12" VerticalAlignment="Center" BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="OsdLogo" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border x:Name="OsdLogoFallback" Background="#1e3a8a" CornerRadius="10" Visibility="Collapsed">
                                        <TextBlock x:Name="OsdLogoFallbackText" Text="TV" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- EPG Info -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock x:Name="OsdTitle" Text="Kanal Yükleniyor..." FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                    <Border x:Name="LiveBadge" Background="#dc2626" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="LiveBadge_MouseLeftButtonUp" ToolTip="Canlı Yayına Dön">
                                        <TextBlock x:Name="LiveBadgeText" Text="🔴 CANLI" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                    <Border x:Name="OsdViewersBadge" Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoEye}" Fill="#38bdf8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="OsdViewersText" Text="0" Foreground="#38bdf8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,2">
                                    <Border Background="#38bdf8" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OsdCategory" Text="TV" Foreground="Black" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                    <TextBlock x:Name="OsdCurrentEpg" Text="Yayın akışı bilgisi yükleniyor..." Foreground="#e2e8f0" FontSize="14" Margin="10,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                </StackPanel>

                                <TextBlock x:Name="OsdNextEpg" Grid.Row="2" Text="Sıradaki: --:-- Bilgi yok" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                            </Grid>

                            <!-- Action Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OsdControlButtonStyle}" Click="Rewind10_Click" ToolTip="10sn Geri">
                                    <Path Data="{StaticResource GeoReplay10}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="PlayPauseBtn" Style="{StaticResource OsdControlButtonStyle}" Width="54" Height="54" Background="#2563eb" Click="PlayPause_Click" ToolTip="Oynat / Duraklat">
                                    <Path Data="{StaticResource GeoPause}" Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource OsdControlButtonStyle}" Click="Forward10_Click" ToolTip="10sn İleri">
                                    <Path Data="{StaticResource GeoForward10}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                </Button>

                                <Border Width="1" Height="30" Background="#44FFFFFF" Margin="6,0"/>

                                <!-- Çoklu Dil / Ses İzi Seçici Butonu -->
                                <Grid Margin="3,0">
                                    <Button x:Name="AudioTrackBtn" Style="{StaticResource OsdControlButtonStyle}" Width="Auto" MinWidth="52" Padding="12,8" Click="AudioTrackBtn_Click" ToolTip="Ses İzi / Yayın Dili Seçimi">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoLanguage}" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AudioTrackBtnText" Text="TR" Foreground="White" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border x:Name="AudioTrackCountBadge" Background="#38bdf8" CornerRadius="8" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="Collapsed">
                                        <TextBlock x:Name="AudioTrackCountText" Text="2" Foreground="Black" FontSize="9" FontWeight="ExtraBold"/>
                                    </Border>
                                </Grid>

                                <!-- Ses Normalizasyonu (Dinamik Aralık / Gece Modu) -->
                                <Button x:Name="AudioNormBtn" Style="{StaticResource OsdControlButtonStyle}" Background="#334155" Click="AudioNormBtn_Click" ToolTip="Ses Normalizasyonu (Patlamaları Önler, Fısıltıları Netleştirir)">
                                    <Grid>
                                        <Path Data="{StaticResource GeoSoundWave}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                    </Grid>
                                </Button>

                                <!-- Görüntü Netleştirici (Keskinleştirme & Kontrast İyileştirme) -->
                                <Button x:Name="VideoEnhanceBtn" Style="{StaticResource OsdControlButtonStyle}" Background="#334155" Click="VideoEnhanceBtn_Click" ToolTip="Görüntü Netleştirici &amp; Keskinlik (Daha Berrak ve Net Görüntü)">
                                    <Grid>
                                        <Path Data="{StaticResource GeoSparkle}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                    </Grid>
                                </Button>

                                <Border Width="1" Height="30" Background="#44FFFFFF" Margin="6,0"/>

                                <Button Style="{StaticResource PrimaryButtonStyle}" Width="85" Height="42" Background="#dc2626" Margin="6,0" Click="GoLive_Click" ToolTip="Canlı Yayına Dön">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CANLI" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="MuteBtn" Style="{StaticResource OsdControlButtonStyle}" Click="Mute_Click" Background="#334155" ToolTip="Sesi Kapat / Aç">
                                    <Path Data="{StaticResource GeoVolume}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="FullscreenBtn" Style="{StaticResource OsdControlButtonStyle}" Click="Fullscreen_Click" Background="#334155" ToolTip="Tam Ekran">
                                    <Path Data="{StaticResource GeoFullscreen}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Time / Progress Bar -->
                        <Grid Grid.Row="1" Margin="0,15,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TimeCurrentText" Text="00:00:00" Foreground="#38bdf8" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" FontFamily="Consolas" MinWidth="64"/>
                            </Border>

                            <Slider x:Name="TimeSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" ValueChanged="TimeSlider_ValueChanged" PreviewMouseDown="TimeSlider_PreviewMouseDown" PreviewMouseUp="TimeSlider_PreviewMouseUp" Height="18" Cursor="Hand"/>

                            <Border Grid.Column="2" Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TimeTotalText" Text="CANLI YAYIN" Foreground="#f8fafc" FontSize="11" FontWeight="Bold" TextAlignment="Center" FontFamily="Consolas" MinWidth="85"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Floating Audio Track / Dil Seçim Menüsü -->
                <Border x:Name="AudioTracksFlyout" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,150"
                        Background="#F20F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="16" Width="290" MaxHeight="340"
                        Visibility="Collapsed" MouseEnter="OsdPanel_MouseEnter" MouseLeave="OsdPanel_MouseLeave">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLanguage}" Fill="#38bdf8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Ses İzi / Yayın Dili" Foreground="White" FontWeight="Bold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#94a3b8" Content="✕" FontSize="12" Cursor="Hand" Click="CloseAudioTracksFlyout_Click" Padding="4"/>
                        </Grid>

                        <!-- Audio Tracks List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220">
                            <ItemsControl x:Name="AudioTracksItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" Margin="0,3" Padding="10,8" Cursor="Hand" Click="AudioTrackItem_Click" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Path Grid.Column="0" Data="{StaticResource GeoCheck}" Fill="#38bdf8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding CheckmarkVisibility}"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Details}" Foreground="#94a3b8" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding LangCode}" Foreground="{Binding BadgeForeground}" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Subtitle Toggle / Status -->
                        <Border Grid.Row="2" Margin="0,10,0,0" Padding="8,6" Background="#1e293b" CornerRadius="8">
                            <TextBlock x:Name="AudioTracksInfoFooter" Text="Otomatik akış algılandı" Foreground="#94a3b8" FontSize="11" TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- OSD Toast Anlık Geri Bildirim Bannerı -->
                <Border x:Name="OsdToastBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"
                        Background="#E60F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="20" Padding="18,10"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="OsdToastIcon" Data="{StaticResource GeoSoundWave}" Fill="#38bdf8" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="OsdToastText" Text="Ses Normalizasyonu: AÇIK" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </flyleaf:FlyleafHost>
    </Grid>
</UserControl>
