<UserControl x:Class="StreamMesh.UI.Views.EpgGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:StreamMesh.Converters"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <conv:LogoCacheConverter x:Key="LogoCacheConverter"/>
    </UserControl.Resources>

    <Grid Background="#141414" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="📅 TV Rehberi &amp; Yayın Akışı" FontSize="30" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="GuideSubtitleText" Text="Kanalların geçmiş, canlı ve sonraki program akışı (Catch-up destekli)" FontSize="13" Foreground="#38bdf8" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="GuideSearchBox" Width="230" Height="38" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="GuideSearchBox_TextChanged"/>
                <ComboBox x:Name="WindowRangeCombo" Width="170" Height="38" Margin="0,0,10,0" SelectionChanged="WindowRangeCombo_SelectionChanged">
                    <ComboBoxItem Content="Canlı Pencere (-4s / +8s)" Tag="live" IsSelected="True"/>
                    <ComboBoxItem Content="Son 24 Saat (Geçmiş)" Tag="yesterday"/>
                    <ComboBoxItem Content="Önümüzdeki 24 Saat" Tag="upcoming"/>
                </ComboBox>
                <Button x:Name="RefreshGuideBtn" Content="🔄 Rehberi Yenile" Height="38" Padding="14,0" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshGuideBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Legend -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#dc2626" CornerRadius="4" Padding="8,3" Margin="0,0,12,0">
                    <TextBlock Text="🔴 ŞU AN YAYINDA (Canlı İzle)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Border Background="#0f766e" CornerRadius="4" Padding="8,3" Margin="0,0,12,0">
                    <TextBlock Text="⏮️ GEÇMİŞ / CATCH-UP (Geri Sar &amp; İzle)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Border Background="#334155" CornerRadius="4" Padding="8,3">
                    <TextBlock Text="⏳ SONRAKİ PROGRAM" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Channel EPG Rows -->
        <ListBox x:Name="EpgRowsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1e293b" CornerRadius="12" Padding="14" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Channel Identity -->
                            <Button Grid.Column="0" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="10" Margin="0,0,14,0" Cursor="Hand"
                                    Click="ChannelHeader_Click" Tag="{Binding Channel}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Channel.PrimaryLogoUrl, Converter={StaticResource LogoCacheConverter}}" Width="38" Height="38" Stretch="Uniform" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center" MaxWidth="145">
                                                    <TextBlock Text="{Binding Channel.PrimaryName}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Channel.GroupTitle}" Foreground="#38bdf8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Horizontal Program Timeline Cards -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Programs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,10,0" Padding="12,10" MinWidth="210" MaxWidth="260" Cursor="Hand"
                                                    Click="ProgramTile_Click" Tag="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding TimeRange}" Foreground="#38bdf8" FontSize="11" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Bold"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Program.Title}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Program.Description}" Foreground="#94a3b8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
