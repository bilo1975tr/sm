<UserControl x:Class="StreamMesh.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:StreamMesh.Core.Utils"
             xmlns:conv="clr-namespace:StreamMesh.Converters"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <conv:LogoCacheConverter x:Key="LogoCacheConverter" />
    </UserControl.Resources>

    <Grid Background="#141414">
        <!-- Backdrop -->
        <Image Source="{Binding CurrentBackdrop}" Stretch="UniformToFill" Opacity="0.2">
            <Image.Effect><BlurEffect Radius="30"/></Image.Effect>
        </Image>
        <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="#141414" Offset="0.8"/></LinearGradientBrush></Rectangle.Fill></Rectangle>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[Home_MyLibrary]}"
                               FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding TotalCountText}" FontSize="14" Foreground="#38bdf8" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="SearchBox" Width="250" Height="40" Padding="35,8,10,8"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="Gray" IsHitTestVisible="False"/>
                        <TextBlock Text="Akıllı Arama (Tab: AI)" Foreground="#64748b" IsHitTestVisible="False" VerticalAlignment="Center" Margin="35,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Validation Progress Banner -->
            <Border Grid.Row="1" Background="#881337" CornerRadius="10" Padding="16,12" Margin="0,0,0,18"
                    BorderBrush="#f43f5e" BorderThickness="1"
                    Visibility="{Binding IsValidatingChannels, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Kanal Canlılık Doğrulaması Yapılıyor" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <TextBlock Text="{Binding ValidationStatusText}" FontSize="12" Foreground="#ffe4e6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ProgressBar Height="8" Width="130" Minimum="0" Maximum="100"
                                     Value="{Binding ValidationProgressPercent}"
                                     Foreground="#f43f5e" Background="#4c0519" BorderThickness="0"/>
                        <TextBlock Text="{Binding ValidationProgressPercent, StringFormat='{}{0}%'}" FontSize="11" Foreground="#ffe4e6" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="✕ Durdur" Style="{StaticResource PrimaryButtonStyle}" Background="#be123c" Height="30" Padding="10,0" Margin="15,0,0,0" Click="CancelValidation_Click"/>
                </Grid>
            </Border>

            <!-- Sync / First Run Info Banner -->
            <Border Grid.Row="1" Background="#0f766e" CornerRadius="10" Padding="16,12" Margin="0,0,0,18"
                    BorderBrush="#14b8a6" BorderThickness="1"
                    Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔄" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Yayın Listesi İndiriliyor &amp; Hazırlanıyor" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <TextBlock Text="{Binding SyncStatusMessage}" FontSize="12" Foreground="#ccfbf1" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ProgressBar Height="8" Width="130" Minimum="0" Maximum="100"
                                     Value="{Binding SyncProgressPercent}"
                                     Foreground="#2dd4bf" Background="#134e4a" BorderThickness="0"/>
                        <TextBlock Text="{Binding SyncProgressPercent, StringFormat='{}{0}%'}" FontSize="11" Foreground="#ccfbf1" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar / Categories -->
            <Border Grid.Row="2" Background="#1e293b" CornerRadius="12" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Kaynak / Xtream Hesap Butonları (Yalnızca Xtream veya birden fazla kaynak varsa görünür) -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="0,0,0,8" BorderBrush="#334155" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasMultipleSources, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SourceFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0" Padding="14,6" Height="34" FontSize="12" FontWeight="Bold"
                                                Click="SourceChip_Click" Tag="{Binding Id}" Cursor="Hand"
                                                ToolTip="Sağ tık: Sağlayıcıyı Güncelle veya Sil">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="🔄 Bu Sağlayıcıyı Güncelle (Tüm Kanalları İndir)" Click="RefreshSource_Click"/>
                                                    <MenuItem Header="🗑️ Bu Sağlayıcıyı ve Kanallarını Sil" Click="PurgeSource_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#0f172a"/>
                                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#0284c7"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#38bdf8"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#38bdf8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="CategoryPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[Home_All]}" Tag="All" Click="Category_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="85"/>
                            <Button Content="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[Home_Favorites]}" Tag="Favorites" Click="Category_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="105" Background="#334155"/>
                            <Button Content="TV" Tag="TV" Click="Category_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="75" Background="#334155"/>
                            <Button Content="Filmler" Tag="Movies" Click="Category_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="85" Background="#334155"/>
                            <Button Content="Diziler" Tag="Series" Click="Category_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Width="85" Background="#334155"/>
                            <Button Content="Radyo" Tag="Radio" Click="Category_Click" Style="{StaticResource PrimaryButtonStyle}" Width="85" Background="#334155"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <!-- Doğrula & Tüm Grubu Kapsa Kontrolleri -->
                            <Button Content="▦/▤" ToolTip="Görünümü Değiştir (Grid/List)" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Height="35" Width="40" Margin="0,0,12,0" Click="ToggleView_Click"/>
                            <CheckBox Content="Tüm grubu kapsa" IsChecked="{Binding ValidateAllInGroup}" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" ToolTip="İşaretlenirse sadece ekrandaki sayfayı değil, mevcut arama/kategori/grubun tamamını doğrular"/>
                            <Button Content="⚡ Doğrula" Style="{StaticResource PrimaryButtonStyle}" Background="#e11d48" Foreground="White" FontWeight="Bold" Height="35" Padding="14,0" Margin="0,0,12,0" Click="ValidateChannels_Click" ToolTip="Kanalları test eder ve yayını olmayan ölü kanalları kalıcı olarak siler" Cursor="Hand"/>
                            <ComboBox Width="140" Height="35" x:Name="SortComboBox" SelectionChanged="Sort_SelectionChanged">
                                <ComboBoxItem Content="Alfabetik (A-Z)" IsSelected="True"/>
                                <ComboBoxItem Content="Alfabetik (Z-A)"/>
                                <ComboBoxItem Content="Yeni Eklenenler"/>
                                <ComboBoxItem Content="Favoriler Önce"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Group / Category Title Filter Bar -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="#334155" BorderThickness="0,1,0,0"
                            Visibility="{Binding HasGroupCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GroupCategories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,0" Padding="12,5" Height="30" FontSize="11" FontWeight="SemiBold"
                                                Click="GroupChip_Click" Tag="{Binding Name}" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#0f172a"/>
                                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="15" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#0284c7"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#38bdf8"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#38bdf8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Library Content -->
            <Grid Grid.Row="3">
                <ListView x:Name="ChannelGrid" Background="Transparent" BorderThickness="0" ItemsSource="{Binding DisplayedChannels}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e293b" CornerRadius="12" Width="180" Height="220" Margin="8" BorderThickness="1" BorderBrush="#334155" x:Name="CardBorder" ClipToBounds="True"
                                    MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave"
                                    AllowDrop="True" Drop="Card_Drop" PreviewMouseMove="Card_MouseMove" PreviewMouseLeftButtonDown="Card_MouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Oynat" Click="PlayContext_Click" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Düzenle" Click="EditContext_Click" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Favori Yap/Kaldır" Click="FavContext_Click" CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Sil" Foreground="#ef4444" Click="DeleteContext_Click" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <!-- Logo Area -->
                                    <Border Grid.Row="0" Background="#0f172a" CornerRadius="10,10,0,0">
                                        <Grid>
                                            <Image Source="{Binding PrimaryLogoUrl, Converter={StaticResource LogoCacheConverter}}" Stretch="Uniform" Margin="20"/>
                                            
                                            <!-- Action Overlay (Play) -->
                                            <Button x:Name="PlayOverlayBtn" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Click="DirectPlay_Click" CommandParameter="{Binding}" Cursor="Hand" Opacity="0" Background="Transparent" BorderThickness="0">
                                                <Border Background="#E60284c7" CornerRadius="20" Width="40" Height="40">
                                                    <Path Data="{StaticResource GeoPlay}" Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Info Area -->
                                    <StackPanel Grid.Row="1" Margin="10,8">
                                        <TextBlock Text="{Binding PrimaryName}" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CurrentEpgTitle}" Foreground="#94a3b8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38bdf8"/>
                                    <Setter TargetName="CardBorder" Property="Background" Value="#334155"/>
                                    <Setter TargetName="PlayOverlayBtn" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
                </ListView>

                <ListView x:Name="ChannelList" Background="Transparent" BorderThickness="0" ItemsSource="{Binding DisplayedChannels}"
                          Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e293b" CornerRadius="8" Margin="8,4" Padding="12" BorderThickness="1" BorderBrush="#334155" MouseLeftButtonUp="Card_Click">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Oynat" Click="PlayContext_Click" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Düzenle" Click="EditContext_Click" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Favori Yap/Kaldır" Click="FavContext_Click" CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Sil" Foreground="#ef4444" Click="DeleteContext_Click" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding PrimaryLogoUrl, Converter={StaticResource LogoCacheConverter}}" Width="40" Height="40" Margin="0,0,15,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrimaryName}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                        <TextBlock Text="{Binding CurrentEpgTitle}" Foreground="#94a3b8" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Pagination -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="PrevBtn" Content="&lt; Önceki" Style="{StaticResource PrimaryButtonStyle}" Width="110" Height="40" Margin="0,0,20,0" Click="Prev_Click"/>
                <TextBlock x:Name="PageText" Text="{Binding CurrentPageText}" VerticalAlignment="Center" Foreground="Gray" FontSize="16" FontWeight="SemiBold"/>
                <Button x:Name="NextBtn" Content="Sonraki &gt;" Style="{StaticResource PrimaryButtonStyle}" Width="110" Height="40" Margin="20,0,0,0" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
