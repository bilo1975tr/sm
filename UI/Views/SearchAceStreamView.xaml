<UserControl x:Class="StreamMesh.UI.Views.SearchAceStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100" Background="#141414">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Quick Content-ID Launcher -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AceStream &amp; Global P2P Arama" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="AceStream Content-ID, P2P yayın hash'i, canlı spor kanalları ve global M3U arşivi" 
                           Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚡ AceEngine Motorunu Başlat" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="14,6" Click="StartAceEngine_Click" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar and Quick Hash Direct Launch Bar -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="14" Padding="18" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Direct Content ID / Hash Launcher -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚡ AceStream Hash / ID:" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="TxtContentId" Grid.Column="1" Height="38" Background="#0F172A" Foreground="White" BorderBrush="#334155" 
                             BorderThickness="1" Padding="10,8" FontSize="13" VerticalContentAlignment="Center"
                             ToolTip="40 karakterlik AceStream hash kodunu veya acestream:// linkini buraya yapıştırın"/>
                    <Button Grid.Column="2" Content="▶ Direkt Oynat" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="16,0" Margin="10,0,0,0" Click="PlayContentId_Click"/>
                </Grid>

                <Rectangle Height="1" Fill="#334155" Margin="0,0,0,14"/>

                <!-- Search Input & Filters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearchQuery" Grid.Column="0" Height="40" Background="#0F172A" Foreground="White" BorderBrush="#334155" 
                             BorderThickness="1" Padding="12,8" FontSize="14" VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"
                             ToolTip="Aramak istediğiniz kanal adı, takım, film veya spor yayınını yazın..."/>
                    
                    <ComboBox x:Name="CmbSourceFilter" Grid.Column="1" Height="40" Margin="10,0,0,0" Background="#0F172A" Foreground="White" 
                              BorderBrush="#334155" SelectedIndex="0">
                        <ComboBoxItem Content="Tümü"/>
                        <ComboBoxItem Content="AceStream P2P"/>
                        <ComboBoxItem Content="AceStream (me)"/>
                        <ComboBoxItem Content="AceStream (org)"/>
                        <ComboBoxItem Content="AceStream (net)"/>
                        <ComboBoxItem Content="IPTVCat"/>
                        <ComboBoxItem Content="FreeTuxTV"/>
                        <ComboBoxItem Content="Free-TV"/>
                    </ComboBox>

                    <Button Grid.Column="2" Content="🔍 Ara" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" Margin="10,0,0,0" Click="Search_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Results Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Results status bar -->
            <Grid Grid.Row="0" Margin="4,0,4,10">
                <TextBlock x:Name="TxtResultCount" Text="Aramak için bir anahtar kelime veya AceStream ID girin." Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAddAllToLibrary" Content="➕ Tümünü Kütüphaneye Ekle" 
                            Visibility="Collapsed" 
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12"
                            BorderThickness="0" Height="32" Padding="14,4" Margin="0,0,10,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddAllToLibrary_Click"
                            ToolTip="Aramada listelenen tüm yayınları tek tıkla kütüphanenize kaydeder"/>
                    <ProgressBar x:Name="SearchProgressBar" Height="4" Width="140" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Results List -->
            <ListBox x:Name="ResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A384F"/>
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon / Indicator -->
                                <Border Width="46" Height="46" CornerRadius="8" Background="#0F172A" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Category, StringFormat='Kategori: {0}'}" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding PeersOrDetails}" Foreground="#10B981" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶ Önizle" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0"
                                            Click="PreviewResultItem_Click" CommandParameter="{Binding}" ToolTip="Seçilen yayını hemen önizle/oynat"/>
                                    <Button Content="{Binding AddButtonText}" Height="34" Padding="12,0" 
                                            Background="#0F172A" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            IsEnabled="{Binding CanAdd}"
                                            Click="AddToLibrary_Click" CommandParameter="{Binding}" ToolTip="Bu kanalı kütüphaneme ekle"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
