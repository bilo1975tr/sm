<Window x:Class="StreamMesh.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:StreamMesh.Core.Utils"
        Title="StreamMesh Hybrid v1.0.1" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen" Background="#141414" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111" BorderBrush="#333" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20">
                <Image Source="pack://application:,,,/logos/StreamMesh_logo.png" Width="40" Margin="0,0,0,40"/>

                <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="Nav_Click" Tag="Home" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavLibrary]}">
                    <TextBlock Text="🏠"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="AceSearch" ToolTip="Global Kanal Arama">
                    <TextBlock Text="🔍"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Player" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavPlayer]}">
                    <TextBlock Text="▶"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Stats" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavStats]}">
                    <TextBlock Text="📊"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Settings" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavSettings]}">
                    <TextBlock Text="⚙"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="OpenChat_Click" ToolTip="AI Asistan">
                    <TextBlock Text="💬"/>
                </RadioButton>

                <Border Height="40"/>
                <StackPanel Orientation="Vertical" Cursor="Hand" MouseLeftButtonDown="PeerCount_Click" Background="Transparent" ToolTip="P2P Mesh Raporunu Görüntüle">
                    <TextBlock Text="👥" HorizontalAlignment="Center" FontSize="18"/>
                    <TextBlock x:Name="OnlinePeersText" Text="0" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
</Window>
