<Window x:Class="StreamMesh.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:StreamMesh.Core.Utils"
        Title="StreamMesh Hybrid" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen" Background="#141414" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#111" BorderBrush="#333" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20">
                <!-- StreamMesh Vector Logo -->
                <Viewbox Width="44" Height="44" Margin="0,0,0,40" Cursor="Hand" MouseLeftButtonDown="PeerCount_Click">
                    <Canvas Width="256" Height="256">
                        <Rectangle Width="256" Height="256" RadiusX="60" RadiusY="60" Fill="#0A0C10"/>
                        <Ellipse Canvas.Left="58" Canvas.Top="58" Width="140" Height="140" Stroke="#38BDF8" StrokeThickness="4">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#0F172A" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Polygon Points="110,95 110,161 160,128" Fill="White"/>
                        <Ellipse Canvas.Left="45" Canvas.Top="45" Width="30" Height="30" Fill="#38BDF8"/>
                        <Line X1="60" Y1="60" X2="90" Y2="90" Stroke="#38BDF8" StrokeThickness="4"/>
                        <Ellipse Canvas.Left="181" Canvas.Top="45" Width="30" Height="30" Fill="#6366F1"/>
                        <Line X1="196" Y1="60" X2="166" Y2="90" Stroke="#6366F1" StrokeThickness="4"/>
                    </Canvas>
                </Viewbox>

                <RadioButton Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="Nav_Click" Tag="Home" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavLibrary]}">
                    <TextBlock Text="🏠"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="AceSearch" ToolTip="Global Kanal Arama">
                    <TextBlock Text="🔍"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Player" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavPlayer]}">
                    <TextBlock Text="▶"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Stats" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavStats]}">
                    <TextBlock Text="📊"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Settings" ToolTip="{Binding Source={x:Static utils:LocalizationManager.Instance}, Path=[NavSettings]}">
                    <TextBlock Text="⚙"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="OpenChat_Click" ToolTip="AI Asistan">
                    <TextBlock Text="💬"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButtonStyle}" Click="VIPButton_Click" ToolTip="Destek ve VIP">
                    <TextBlock Text="🎁"/>
                </RadioButton>

                <Border Height="40"/>
                <StackPanel Orientation="Vertical" Cursor="Hand" MouseLeftButtonDown="PeerCount_Click" Background="Transparent" ToolTip="P2P Mesh Raporunu Görüntüle">
                    <TextBlock Text="👥" HorizontalAlignment="Center" FontSize="18"/>
                    <TextBlock x:Name="OnlinePeersText" Text="0" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl x:Name="MainContent" />

            <!-- Top Right Update & Version Overlay -->
            <StackPanel x:Name="TopOverlay" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,20,0" Panel.ZIndex="1000">
                <!-- Update Notification Button (Hidden by default, shown when remote update available) -->
                <Button x:Name="UpdateBadgeButton" 
                        Click="UpdateBadge_Click" 
                        Visibility="Collapsed" 
                        Background="#E11D48" Foreground="White" FontWeight="Bold" FontSize="12" 
                        Padding="12,6" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"
                        ToolTip="Yeni sürüm yayınlandı! Tıklayarak otomatik güncelleyin.">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,6,0" FontSize="13"/>
                        <TextBlock x:Name="UpdateBadgeText" Text="Yeni Güncelleme Var! (Tıkla ve Güncelle)"/>
                    </StackPanel>
                </Button>

                <!-- Current Version Badge -->
                <Border Background="#1E1E1E" CornerRadius="12" Padding="10,5" BorderBrush="#333" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="v" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentVersionBadge" Text="0.1.0" Foreground="#CCC" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
