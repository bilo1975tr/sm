<Window x:Class="StreamMesh.UI.Windows.MultiViewChannelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StreamMesh.Converters"
        Title="Ekran Kanal Seçimi" Height="650" Width="760"
        MinHeight="500" MinWidth="620"
        Background="#0f172a" Foreground="White" WindowStartupLocation="CenterOwner"
        Icon="{StaticResource AppIconImage}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:LogoCacheConverter x:Key="LogoCacheConverter" />
    </Window.Resources>

    <Border CornerRadius="16" Background="#0f172a" BorderBrush="#38bdf8" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284c7" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock x:Name="SlotBadgeText" Text="EKRAN 1" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Çoklu İzleme İçin Kanal Seçin" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="32" Height="32" Background="#1e293b" Foreground="#cbd5e1"
                        BorderThickness="0" Content="✕" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>

            <!-- Çakışma Koruması Bilgi Bannerı -->
            <Border Grid.Row="1" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ConflictStatusText"
                               Text="Aktif sunucu kilidi yok — tüm kanallar gösteriliyor."
                               Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Aynı sunucudan eşzamanlı 2. bağlantı engellenir (1 IP / 1 kullanıcı koruması) ve AceStream açıkken diğer AceStream kanalları gizlenir."
                               Foreground="#94a3b8" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Arama ve Grup Filtresi -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" Height="40" FontSize="13" VerticalContentAlignment="Center"
                             Padding="12,0" ToolTip="Kanal adı veya grup ara..." TextChanged="FilterChanged"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="🔍 Kanal adı, grup veya sunucu ara..."
                               Foreground="#64748b" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <ComboBox x:Name="GroupFilterCombo" Grid.Column="1" Height="40" Margin="10,0,0,0"
                          SelectionChanged="FilterChanged"/>

                <CheckBox x:Name="IncludeVodCheck" Grid.Column="2" Content="VOD Dahil" Foreground="#cbd5e1"
                          VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                          Checked="FilterChanged" Unchecked="FilterChanged"/>
            </Grid>

            <!-- Sanallaştırılmış Kanal Listesi -->
            <Border Grid.Row="3" Background="#0b1120" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="10" Padding="4">
                <Grid>
                    <ListBox x:Name="ChannelListBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="ChannelListBox_MouseDoubleClick"
                             SelectionChanged="ChannelListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="#131c31" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1e293b"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#38bdf8"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#0c4a6e"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#38bdf8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" Background="#1e293b" CornerRadius="8" ClipToBounds="True">
                                        <Image Source="{Binding LogoUrl, Converter={StaticResource LogoCacheConverter}}" Stretch="Uniform" Margin="3"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#94a3b8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ServerBadge}" Foreground="#38bdf8" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyStateText"
                               Text="Kanallar yükleniyor..."
                               Foreground="#94a3b8" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
                </Grid>
            </Border>

            <!-- Alt Bar -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock x:Name="CountSummaryText" Text="0 kanal" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal" Width="90" Height="36" Margin="0,0,10,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
                    <Button x:Name="SelectBtn" Content="📺 Seç ve Oynat" Width="140" Height="36" IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,0" Click="Select_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
