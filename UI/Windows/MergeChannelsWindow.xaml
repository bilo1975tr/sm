<Window x:Class="StreamMesh.UI.Windows.MergeChannelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StreamMesh.Converters"
        Title="Kanal Birleştirme Sihirbazı" Height="780" Width="980"
        Background="#0f172a" Foreground="White" WindowStartupLocation="CenterOwner"
        Icon="{StaticResource AppIconImage}"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <conv:LogoCacheConverter x:Key="LogoCacheConverter" />
        <conv:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Custom Radio Button Style for Filters -->
        <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#64748b" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38bdf8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369a1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38bdf8"/>
                                <Setter TargetName="dot" Property="Fill" Value="#38bdf8"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Custom Small Button Style with 6px rounded corners -->
        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e293b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#0f172a" BorderBrush="#334155" BorderThickness="1.5">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Main Channel Info Card -->
                <RowDefinition Height="Auto"/>
                <!-- Search & Filters Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Candidate List -->
                <RowDefinition Height="*"/>
                <!-- Footer Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoTv}" Fill="#38bdf8" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kanal Birleştirme Sihirbazı" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kullanıcı kontrollü güvenli kanal birleştirme: Seçilen kanallar ana kanalın altında alternatif yayın olarak toplanır."
                               FontSize="12" Foreground="#64748b" Margin="30,2,0,0"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Content="✕" Width="36" Height="36" Background="Transparent" Foreground="#94a3b8" FontSize="18" BorderThickness="0" Click="Close_Click" ToolTip="Kapat" Cursor="Hand"/>
            </Grid>

            <!-- 2. Main Channel Card (Ana Kanal) -->
            <Border Grid.Row="1" Background="#1e293b" BorderBrush="#0284c7" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Channel Logo -->
                    <Border Grid.Column="0" Width="56" Height="56" Background="#0f172a" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Margin="0,0,14,0">
                        <Grid>
                            <Path Data="{StaticResource GeoTv}" Fill="White" Width="24" Height="24" Stretch="Uniform" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding MainChannel.PrimaryLogoUrl, Converter={StaticResource LogoCacheConverter}}" Stretch="Uniform" Margin="4"/>
                        </Grid>
                    </Border>

                    <!-- Main Channel Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#0284c7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="ANA KANAL" Foreground="White" FontWeight="Bold" FontSize="10"/>
                            </Border>
                            <TextBlock Text="{Binding MainChannel.PrimaryName}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <WrapPanel VerticalAlignment="Center">
                            <Border Background="#334155" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding MainChannel.Category}" Foreground="#38bdf8" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#334155" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding MainChannelLanguageDisplay}" Foreground="#f8fafc" FontSize="11"/>
                            </Border>
                            <Border Background="#0f172a" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding MainChannelSourceCountText}" Foreground="#94a3b8" FontSize="11"/>
                            </Border>
                            <TextBlock Text="{Binding MainChannelEpgDisplay}" Foreground="#64748b" FontSize="11" Margin="4,2,0,0" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Preservation Badge -->
                    <Border Grid.Column="2" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ Ana Kanal Korunur" Foreground="#38bdf8" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Search and Match Filter Bar -->
            <Border Grid.Row="2" Background="#1e293b" CornerRadius="12" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Input Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="38"
                                 Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged"/>

                        <Button Grid.Column="1" Content="🔍 Yenile" Height="38" Width="80" Style="{StaticResource PrimaryButtonStyle}"
                                Background="#334155" Click="RefreshSearch_Click" Margin="0,0,8,0" Padding="0"/>

                        <!-- Category Filter Dropdown -->
                        <ComboBox Grid.Column="2" x:Name="CategoryFilterCombo" Height="38" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Tüm Kategoriler" IsSelected="True"/>
                            <ComboBoxItem Content="TV"/>
                            <ComboBoxItem Content="Film"/>
                            <ComboBoxItem Content="Dizi"/>
                            <ComboBoxItem Content="Radyo"/>
                        </ComboBox>

                        <!-- Language Filter Dropdown -->
                        <ComboBox Grid.Column="3" x:Name="LanguageFilterCombo" Height="38" SelectionChanged="Filter_SelectionChanged">
                            <ComboBoxItem Content="Tüm Diller" IsSelected="True"/>
                            <ComboBoxItem Content="Türkçe (TR)"/>
                            <ComboBoxItem Content="Almanca (DE)"/>
                            <ComboBoxItem Content="İngilizce (EN)"/>
                            <ComboBoxItem Content="Diğer"/>
                        </ComboBox>
                    </Grid>

                    <!-- Filter Mode Radio Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Eşleşme Modu:" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="Birebir Aynı (Exact)" Style="{StaticResource FilterRadioButtonStyle}" IsChecked="{Binding IsExactMatchMode, Mode=TwoWay}" Checked="FilterMode_Checked"/>
                        <RadioButton Content="İçerenler (Contains)" Style="{StaticResource FilterRadioButtonStyle}" IsChecked="{Binding IsContainsMode, Mode=TwoWay}" Checked="FilterMode_Checked"/>
                        <RadioButton Content="İsimde Geçenler (Kelimeler)" Style="{StaticResource FilterRadioButtonStyle}" IsChecked="{Binding IsSubstringsMode, Mode=TwoWay}" Checked="FilterMode_Checked"/>
                        <RadioButton Content="Benzer İsimler (Normalized)" Style="{StaticResource FilterRadioButtonStyle}" IsChecked="{Binding IsSimilarMode, Mode=TwoWay}" Checked="FilterMode_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Candidate Channels List -->
            <Border Grid.Row="3" Background="#1e293b" CornerRadius="12" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Subheader: Selection toolbar & Candidates count -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Birleştirilebilecek Aday Kanallar (" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FilteredCandidates.Count}" Foreground="#38bdf8" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text=" Kanal Bulundu)" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✓ Tümünü Seç" Height="28" Style="{StaticResource SmallActionButtonStyle}" Foreground="White" Margin="0,0,8,0" Click="SelectAll_Click" FontSize="11"/>
                            <Button Content="✕ Seçimleri Kaldır" Height="28" Style="{StaticResource SmallActionButtonStyle}" Foreground="#94a3b8" Click="DeselectAll_Click" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable List of Candidates -->
                    <ListBox Grid.Row="1" x:Name="CandidatesListBox" ItemsSource="{Binding FilteredCandidates}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0f172a" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="10" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38bdf8"/>
                                                    <Setter Property="Background" Value="#172554"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Checkbox -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Channel Logo -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Channel Info -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Live Preview / Snapshot Action -->
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection CheckBox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,12,0" Cursor="Hand"/>

                                        <!-- Candidate Logo -->
                                        <Border Grid.Column="1" Width="44" Height="44" Background="#1e293b" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Path Data="{StaticResource GeoTv}" Fill="White" Width="18" Height="18" Stretch="Uniform" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Channel.PrimaryLogoUrl, Converter={StaticResource LogoCacheConverter}}" Stretch="Uniform" Margin="2"/>
                                            </Grid>
                                        </Border>

                                        <!-- Candidate Metadata -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Channel.Name}" FontWeight="Bold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                <Border Background="#334155" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LanguageDisplay}" Foreground="#f8fafc" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#1e293b" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Channel.Category}" Foreground="#38bdf8" FontSize="10"/>
                                                </Border>
                                            </StackPanel>

                                            <WrapPanel Margin="0,3,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Kaynak: " Foreground="#64748b" FontSize="11"/>
                                                <TextBlock Text="{Binding UrlPreview}" Foreground="#94a3b8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                <TextBlock Text="{Binding EpgInfoText}" Foreground="#64748b" FontSize="10" Margin="10,0,0,0"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Live Single-Frame Preview Section -->
                                        <Border Grid.Column="3" Background="#1e293b" CornerRadius="8" Padding="6" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Preview Area / Status -->
                                                <Border Grid.Row="0" Height="65" Background="#0f172a" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,4">
                                                    <Grid>
                                                        <!-- Placeholder when no frame taken -->
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                                                            <Path Data="{StaticResource GeoPlay}" Fill="#64748b" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding PreviewStatusText}" FontSize="10" Foreground="#94a3b8" TextAlignment="Center" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <!-- Captured Snapshot Image -->
                                                        <Image Source="{Binding PreviewSnapshot}" Stretch="UniformToFill" Margin="0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Button to take single-frame snapshot -->
                                                <Button Grid.Row="1" Content="📸 Canlı Kare Al" Padding="6,3" Height="26" Style="{StaticResource PrimaryButtonStyle}"
                                                        Background="#334155" Foreground="White" FontSize="10" Click="CapturePreview_Click" Tag="{Binding}" ToolTip="Tek kare canlı önizleme al (Yayınları aynı anda oynatmaz)"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Message -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                        <Path Data="{StaticResource GeoSearch}" Fill="#64748b" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Arama kriterlerinize uygun aday kanal bulunamadı." FontSize="14" FontWeight="SemiBold" Foreground="#94a3b8" TextAlignment="Center"/>
                        <TextBlock Text="Farklı bir arama kelimesi yazabilir veya 'İçerenler' / 'Benzer İsimler' eşleşme modunu seçebilirsiniz." FontSize="11" Foreground="#64748b" Margin="0,4,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Footer Actions -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Seçilen Aday Sayısı: " Foreground="#94a3b8" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedCandidatesCount}" Foreground="#38bdf8" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" adet kanal" Foreground="#94a3b8" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="İptal / Kapat" Width="120" Height="42" Margin="0,0,12,0" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Click="Close_Click"/>
                    <Button Content="🔗 Seçilenleri Birleştir" Width="200" Height="42" Style="{StaticResource PrimaryButtonStyle}" Background="#0284c7" Click="MergeSelected_Click" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
