<Window x:Class="StreamMesh.UI.Windows.P2PReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamMesh P2P Durum Raporu" Height="520" Width="600"
        WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="StreamMesh P2P Mesh Durum Raporu" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="STUN/TURN NAT eşleşmeleri, dış uç nokta ve aktif eş (peer) tanıları" 
                           Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Report Text in Monospace / Code Style Container -->
        <Border Grid.Row="1" Background="#0A0C10" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtReport" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" 
                         FontFamily="Consolas, Courier New" FontSize="13" TextWrapping="Wrap" IsReadOnly="True"/>
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="🔄 STUN Yeniden Test Et" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}" 
                    Height="38" Padding="14,0" Click="RetestStun_Click"/>

            <Button Grid.Column="2" Content="📋 Kopyala" Background="#334155" Style="{StaticResource PrimaryButtonStyle}" 
                    Height="38" Padding="16,0" Margin="0,0,10,0" Click="Copy_Click"/>

            <Button Grid.Column="3" Content="Kapat" Background="#1E293B" Style="{StaticResource PrimaryButtonStyle}" 
                    Height="38" Padding="18,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
