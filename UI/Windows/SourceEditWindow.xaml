<Window x:Class="StreamMesh.UI.Windows.SourceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaynak Düzenle ve Link Testi" Height="600" Width="900"
        Background="#0f172a" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="SourceTitle" FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Text="Kaynak: ..."/>
            <TextBlock x:Name="SourceStats" Foreground="Gray" Text="Yükleniyor..."/>
        </StackPanel>

        <DataGrid x:Name="ChannelList" Grid.Row="1" Background="#1e293b" BorderBrush="#334155"
                  AutoGenerateColumns="False" CanUserAddRows="False" Foreground="White" RowBackground="#1e293b">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kanal Adı" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Dil" Binding="{Binding Language}" Width="60"/>
                <DataGridTemplateColumn Header="Hız / Durum" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="StatusText" Text="{Binding Notes}" FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="⚡ Linkleri Test Et" Width="150" Height="40" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="TestLinks_Click"/>
            <Button Content="🧹 Ölüleri Sil" Width="130" Height="40" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Click="DeleteDead_Click"/>
            <Button Content="💾 Değişiklikleri Kaydet" Width="160" Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
