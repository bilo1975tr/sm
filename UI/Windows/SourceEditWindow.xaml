<Window x:Class="StreamMesh.UI.Windows.SourceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaynak Düzenleme, Toplu Kategori/Dil/Grup Yönetimi ve Link Testi" 
        Height="720" Width="1100" MinWidth="900" MinHeight="600"
        Background="#0f172a" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık ve İstatistik Bilgisi -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SourceTitle" FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Text="Kaynak: ..." TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SourceStats" Foreground="#94a3b8" FontSize="13" Margin="0,4,0,0" Text="Yükleniyor..."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionCountText" Text="Seçili: 0 kanal" Foreground="#38bdf8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button Content="☑ Tümünü Seç" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Click="SelectAll_Click"/>
                <Button Content="☐ Seçimi Kaldır" Height="32" Padding="12,0" Style="{StaticResource PrimaryButtonStyle}" Background="#334155" Click="DeselectAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filtreleme ve Toplu Düzenleme Araç Çubuğu (Toolbar) -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Satır 1: Canlı Arama ve Sadece Seçilenler Filtresi -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="36" Padding="10,6" FontSize="13" 
                             Tag="Kanal adı veya grup adına göre filtrele..." 
                             TextChanged="SearchBox_TextChanged"/>
                    <CheckBox Grid.Column="1" x:Name="CheckOnlySelected" Content="Sadece Seçilenleri Göster" 
                              Foreground="#f1f5f9" FontWeight="SemiBold" FontSize="12" 
                              VerticalAlignment="Center" Margin="15,0,0,0"
                              Checked="CheckOnlySelected_Changed" Unchecked="CheckOnlySelected_Changed"/>
                </Grid>

                <!-- Satır 2: Toplu Kategori, Dil ve Title Grubu Değiştirme -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toplu Kategori -->
                    <TextBlock Grid.Column="0" Text="Kategori:" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" x:Name="BulkCategoryBox" Height="34" SelectedIndex="0" Margin="0,0,12,0">
                        <ComboBoxItem Content="TV"/>
                        <ComboBoxItem Content="Film"/>
                        <ComboBoxItem Content="Dizi"/>
                        <ComboBoxItem Content="Radyo"/>
                    </ComboBox>

                    <!-- Toplu Dil -->
                    <TextBlock Grid.Column="2" Text="Dil:" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="3" x:Name="BulkLanguageBox" Height="34" SelectedIndex="0" Margin="0,0,12,0">
                        <ComboBoxItem Content="tr"/>
                        <ComboBoxItem Content="de"/>
                        <ComboBoxItem Content="en"/>
                        <ComboBoxItem Content="fr"/>
                        <ComboBoxItem Content="es"/>
                        <ComboBoxItem Content="it"/>
                        <ComboBoxItem Content="az"/>
                        <ComboBoxItem Content="ru"/>
                        <ComboBoxItem Content="ar"/>
                        <ComboBoxItem Content="und"/>
                    </ComboBox>

                    <!-- Toplu Title Grubu -->
                    <TextBlock Grid.Column="4" Text="Grup (Title):" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="5" x:Name="BulkGroupTitleBox" Height="34" Padding="8,4" Margin="0,0,12,0" Tag="Yeni grup/title adı..."/>

                    <!-- Toplu Uygula Butonu -->
                    <Button Grid.Column="6" Content="⚡ Seçilenlere Uygula" Height="34" Padding="14,0" 
                            Style="{StaticResource PrimaryButtonStyle}" Background="#0284c7" 
                            Click="ApplyBulkEdit_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Kanal Tablosu (DataGrid) -->
        <DataGrid x:Name="ChannelList" Grid.Row="2" Background="#1e293b" BorderBrush="#334155"
                  AutoGenerateColumns="False" CanUserAddRows="False" Foreground="White" 
                  RowBackground="#1e293b" AlternatingRowBackground="#0f172a" 
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                  HeadersVisibility="Column" SelectionMode="Extended">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0f172a"/>
                    <Setter Property="Foreground" Value="#38bdf8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <!-- Seçim Checkbox Kolonu -->
                <DataGridTemplateColumn Width="45">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Click="ChannelCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Kanal Adı -->
                <DataGridTextColumn Header="Kanal Adı" Binding="{Binding Name, Mode=TwoWay}" Width="*"/>

                <!-- Title Grubu (Düzenlenebilir) -->
                <DataGridTextColumn Header="Grup / Title" Binding="{Binding GroupTitle, Mode=TwoWay}" Width="160"/>

                <!-- Kategori -->
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category, Mode=TwoWay}" Width="90"/>

                <!-- Dil -->
                <DataGridTextColumn Header="Dil" Binding="{Binding Language, Mode=TwoWay}" Width="60"/>

                <!-- Hız / Durum -->
                <DataGridTemplateColumn Header="Hız / Durum" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Notes}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#38bdf8"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Akış URL'si -->
                <DataGridTextColumn Header="Yayın Linki (URL)" Binding="{Binding Url, Mode=TwoWay}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Alt Butonlar -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Butonlar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="⚡ Linkleri Test Et" Width="140" Height="38" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="TestLinks_Click"/>
                <Button Content="🧹 Ölüleri Sil" Width="120" Height="38" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Background="#7f1d1d" Click="DeleteDead_Click"/>
                <Button Content="🗑️ Seçilenleri Sil" Width="140" Height="38" Style="{StaticResource PrimaryButtonStyle}" Background="#991b1b" Click="DeleteSelected_Click"/>
            </StackPanel>

            <!-- Sağ Kaydet Butonları -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="✕ Vazgeç" Width="100" Height="38" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Background="#475569" Click="Cancel_Click"/>
                <Button Content="💾 Değişiklikleri Kaydet" Width="180" Height="38" Style="{StaticResource PrimaryButtonStyle}" Background="#16a34a" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
