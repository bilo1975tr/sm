<Window x:Class="StreamMesh.UI.Windows.LegalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yasal Bildirim" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0f172a" Foreground="#f8fafc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Yasal Bildirim ve Gizlilik" FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,15" TextAlignment="Center"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#1e293b" Padding="15">
            <TextBlock TextWrapping="Wrap" Foreground="#e2e8f0">
                StreamMesh bir medya oynatıcıdır. İçerik barındırmaz. Kullanıcılar kendi listelerini ekler.
            </TextBlock>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Reddet" Width="100" Margin="0,0,10,0" Background="#ef4444" Foreground="White" Click="Decline_Click"/>
            <Button Content="Onaylıyorum" Width="150" Style="{StaticResource PrimaryButtonStyle}" Click="Accept_Click"/>
        </StackPanel>
    </Grid>
</Window>
