<Window x:Class="StreamMesh.UI.Windows.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destek ve VIP Topluluk" Height="500" Width="550"
        Background="#0f172a" Foreground="White" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="💎 StreamMesh VIP &amp; Destek" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#38bdf8" Margin="0,0,0,8"/>
            <TextBlock Text="StreamMesh açık kaynaklı ve ücretsiz bir projedir. Sunucu ve ağ altyapısını destekleyerek projenin gelişmesine katkıda bulunabilirsiniz." TextWrapping="Wrap" TextAlignment="Center" Foreground="#94a3b8" FontSize="12" Margin="0,0,0,20"/>

            <Border Background="#1e293b" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="💳 Papara / IBAN Destek" FontWeight="Bold" Foreground="#f87171" FontSize="14" Margin="0,0,0,8"/>
                    <TextBox x:Name="IbanBox" Text="TR00 0000 0000 0000 0000 0000 00 (StreamMesh Destek)" IsReadOnly="True" Background="#0f172a" Foreground="#cbd5e1" Padding="8" BorderThickness="1" BorderBrush="#475569" Margin="0,0,0,8"/>
                    <Button Content="IBAN Bilgisini Kopyala" Style="{StaticResource PrimaryButtonStyle}" Click="CopyIban_Click" Height="34"/>
                </StackPanel>
            </Border>

            <Border Background="#1e293b" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🪙 Kripto Para (USDT TRC20)" FontWeight="Bold" Foreground="#34d399" FontSize="14" Margin="0,0,0,8"/>
                    <TextBox x:Name="CryptoBox" Text="TStreamMeshCryptoAddressSupport2026Usdt" IsReadOnly="True" Background="#0f172a" Foreground="#cbd5e1" Padding="8" BorderThickness="1" BorderBrush="#475569" Margin="0,0,0,8"/>
                    <Button Content="Kripto Adresini Kopyala" Style="{StaticResource PrimaryButtonStyle}" Click="CopyCrypto_Click" Height="34"/>
                </StackPanel>
            </Border>

            <Button Content="Kapat" Background="#334155" Foreground="White" FontWeight="Bold" Height="36" Cursor="Hand" Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
