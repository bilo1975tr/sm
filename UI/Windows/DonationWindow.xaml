<Window x:Class="StreamMesh.UI.Windows.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destek ve VIP Topluluk" Height="380" Width="550"
        Background="#0f172a" Foreground="White" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="💎 StreamMesh VIP &amp; Destek" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#38bdf8" Margin="0,0,0,8"/>
            <TextBlock Text="StreamMesh açık kaynaklı ve ücretsiz bir projedir. Sunucu ve ağ altyapısını destekleyerek projenin gelişmesine katkıda bulunabilirsiniz." TextWrapping="Wrap" TextAlignment="Center" Foreground="#94a3b8" FontSize="12" Margin="0,0,0,20"/>

            <Border Background="#1e293b" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🪙 Kripto Para (USDT)" FontWeight="Bold" Foreground="#34d399" FontSize="14"/>
                        <Border Background="#065f46" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BSC / BEP20" Foreground="#a7f3d0" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBox x:Name="CryptoBox" Text="0xbfa68d4757ceffb2492f467671f6b28c343620f2" IsReadOnly="True" Background="#0f172a" Foreground="#38bdf8" FontWeight="SemiBold" Padding="10" BorderThickness="1" BorderBrush="#38bdf8" Margin="0,0,0,12"/>
                    <Button Content="USDT (BEP20) Adresini Kopyala" Style="{StaticResource PrimaryButtonStyle}" Click="CopyCrypto_Click" Height="36"/>
                </StackPanel>
            </Border>

            <Button Content="Kapat" Background="#334155" Foreground="White" FontWeight="Bold" Height="36" Cursor="Hand" Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
