<Window x:Class="StreamMesh.UI.Windows.MediaDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Details" Height="800" Width="1000"
        Background="#141414" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Section -->
        <Grid Grid.Row="0">
            <Image Source="{Binding Media.BackdropUrl}" Stretch="UniformToFill"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.5"/>
                        <GradientStop Color="#141414" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    FontSize="24" Margin="20" Click="Close_Click" Cursor="Hand"/>

            <StackPanel VerticalAlignment="Bottom" Margin="40">
                <TextBlock Text="{Binding Media.CleanName}" FontSize="48" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="{Binding Media.MovieYear}" Foreground="Gray" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Media.ImdbRating, StringFormat='★ {0}'}" Foreground="#eab308" FontWeight="Bold" Margin="0,0,20,0"
                               Visibility="{Binding Media.HasImdb, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                        <TextBlock Text="HD" Foreground="Gray" Padding="4,0"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="▶ İzlemeye Başla" Padding="25,12" Background="#38bdf8" Foreground="Black"
                            FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0" Click="PlayMain_Click" Cursor="Hand"/>
                    <Button Content="🎬 Fragman" Padding="20,12" Background="#334155" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Click="PlayTrailer_Click" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Details & Episodes -->
        <ScrollViewer Grid.Row="1" Padding="40,20">
            <StackPanel>
                <TextBlock Text="{Binding Media.Overview}" Foreground="White" FontSize="18" TextWrapping="Wrap" LineHeight="24"/>

                <TextBlock Text="Oyuncular" Foreground="Gray" Margin="0,25,0,8" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding CastList}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e293b" CornerRadius="4" Margin="0,0,8,8" Padding="12,6" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="{Binding}" Foreground="#38bdf8"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Bölümler" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,40,0,15"
                           Visibility="{Binding Episodes.Count, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <ListBox x:Name="EpisodeList" Background="Transparent" BorderThickness="0" Margin="0,10"
                         ItemsSource="{Binding Episodes}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5" Height="80">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Duration}" Foreground="Gray" FontSize="12"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="12" MaxHeight="40" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
