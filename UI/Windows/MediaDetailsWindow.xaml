<Window x:Class="StreamMesh.UI.Windows.MediaDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StreamMesh.Converters"
        Title="Medya Detayları" Height="750" Width="950"
        Background="#141414" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" WindowStyle="None">
    <Window.Resources>
        <conv:LogoCacheConverter x:Key="LogoCacheConverter" />
    </Window.Resources>

    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="15" Background="#141414">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="360"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero Section -->
            <Grid Grid.Row="0">
                <Image Source="{Binding HeroImageUrl, Converter={StaticResource LogoCacheConverter}}" Stretch="UniformToFill" Opacity="0.5"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0.3"/>
                            <GradientStop Color="#141414" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="24" Margin="20" Click="Close_Click" Cursor="Hand"/>

                <Grid VerticalAlignment="Bottom" Margin="40,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Poster Image -->
                    <Border Grid.Column="0" Width="120" Height="180" CornerRadius="8" ClipToBounds="True" Margin="0,0,25,0"
                            Background="#1e293b" BorderBrush="#334155" BorderThickness="1">
                        <Image Source="{Binding Media.LogoUrl, Converter={StaticResource LogoCacheConverter}}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Media.PrimaryName}" FontSize="36" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <TextBlock Text="{Binding Media.Category}" Foreground="#38bdf8" FontWeight="SemiBold" Margin="0,0,15,0"/>
                            <TextBlock Text="{Binding Media.LanguageDisplayName}" Foreground="#94a3b8" Margin="0,0,15,0"/>
                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="HD" Foreground="#94a3b8" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="▶ İzlemeye Başla" Padding="25,12" Background="#38bdf8" Foreground="Black"
                                    FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0" Click="PlayMain_Click" Cursor="Hand"/>
                            <Button Content="🎬 Fragman" Padding="20,12" Background="#334155" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" Click="PlayTrailer_Click" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Details & Episodes -->
            <ScrollViewer Grid.Row="1" Padding="40,20">
                <StackPanel>
                    <TextBlock Text="Özet" Foreground="#94a3b8" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding OverviewText}" Foreground="#e2e8f0" FontSize="16" TextWrapping="Wrap" LineHeight="24"/>

                    <TextBlock Text="Oyuncular" Foreground="#94a3b8" FontSize="14" Margin="0,25,0,8" FontWeight="SemiBold"
                               Visibility="{Binding CastList.Count, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding CastList}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1e293b" CornerRadius="6" Margin="0,0,8,8" Padding="12,6" BorderBrush="#334155" BorderThickness="1">
                                    <TextBlock Text="{Binding}" Foreground="#38bdf8" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Bölümler" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,30,0,15"
                               Visibility="{Binding Episodes.Count, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ListBox x:Name="EpisodeList" Background="Transparent" BorderThickness="0" Margin="0,10"
                             ItemsSource="{Binding Episodes}" HorizontalContentAlignment="Stretch"
                             Visibility="{Binding Episodes.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5" Height="80">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Grid.Column="0"/>
                                    <StackPanel Grid.Column="1" Margin="15,0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Duration}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="12" MaxHeight="40" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
