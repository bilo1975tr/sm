<Window x:Class="StreamMesh.UI.Windows.AiBatchDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Batch Ayrıntıları (Öncesi / Sonrası)" Height="550" Width="850"
        Background="#0f172a" Foreground="White" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Yapay Zeka Batch Öncesi ve Sonrası Değişim Raporu" FontSize="20" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" x:Name="ReportSubtitleText" Text="Rapor detayları yükleniyor..." FontSize="13" Foreground="#94a3b8" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" x:Name="ChangesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Background="#1e293b" Foreground="White" BorderBrush="#334155" RowBackground="#0f172a" AlternatingRowBackground="#1e293b">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Eski İsim (Öncesi)" Binding="{Binding OldName}" Width="*"/>
                <DataGridTextColumn Header="Yeni İsim (Sonrası)" Binding="{Binding NewName}" Width="*"/>
                <DataGridTextColumn Header="Eski Kategori" Binding="{Binding OldCategory}" Width="120"/>
                <DataGridTextColumn Header="Yeni Kategori" Binding="{Binding NewCategory}" Width="120"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding ChangeSummary}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Kapat" Width="120" Height="35" HorizontalAlignment="Right" Margin="0,15,0,0"
                Style="{StaticResource PrimaryButtonStyle}" Click="Close_Click"/>
    </Grid>
</Window>
